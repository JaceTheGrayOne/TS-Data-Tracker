Option Explicit


'============================================================
' MODULE CONSTANTS
'============================================================

Private Const FIRST_RECORD_ROW As Long = 2

Private Const COL_DATE As Long = 1
Private Const COL_UUT As Long = 2
Private Const COL_SN As Long = 3
Private Const COL_FAILURE_TYPE As Long = 4
Private Const COL_TEST As Long = 5
Private Const COL_TEST_STEP As Long = 6
Private Const COL_SUB_STEP_3 As Long = 9
Private Const COL_SUB_STEP_4 As Long = 10
Private Const COL_LAST_RECORD_FIELD As Long = 14

Private Const COL_FIRST_HIERARCHY_FIELD As Long = COL_TEST
Private Const COL_FIRST_NODE_SYNC_FIELD As Long = COL_TEST_STEP
Private Const COL_LAST_RECONCILE_FIELD As Long = COL_SUB_STEP_3
Private Const COL_LAST_HIERARCHY_FIELD As Long = COL_SUB_STEP_4

Private Const CHANGE_UUT As Long = 1
Private Const CHANGE_SN As Long = 2
Private Const CHANGE_FAILURE_TYPE As Long = 4
Private Const CHANGE_TEST As Long = 8
Private Const CHANGE_TEST_STEP As Long = 16
Private Const CHANGE_SUB_STEP_1 As Long = 32
Private Const CHANGE_SUB_STEP_2 As Long = 64
Private Const CHANGE_SUB_STEP_3 As Long = 128
Private Const CHANGE_SUB_STEP_4 As Long = 256

Private Const CHANGE_HIERARCHY_FIELDS As Long = CHANGE_TEST + CHANGE_TEST_STEP + CHANGE_SUB_STEP_1 + _
    CHANGE_SUB_STEP_2 + CHANGE_SUB_STEP_3 + CHANGE_SUB_STEP_4

Private Const CHANGE_STATE_FIELDS As Long = CHANGE_FAILURE_TYPE + CHANGE_HIERARCHY_FIELDS


'============================================================
' WORKSHEET EVENTS
'============================================================

Private Sub Worksheet_Change(ByVal target As Range)

    Dim entryRange As Range
    Dim boundedRange As Range
    Dim changedRange As Range
    Dim changedArea As Range
    Dim changedRows As Object
    Dim rowKey As Variant
    Dim rowNumber As Long
    Dim firstChangedRow As Long
    Dim lastChangedRow As Long
    Dim columnNumber As Long
    Dim changedColumns As Long
    Dim lastTrackedRow As Long
    Dim previousEnableEvents As Boolean
    Dim previousScreenUpdating As Boolean
    Dim applicationStateSaved As Boolean
    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    On Error GoTo Cleanup

    Set entryRange = Me.Range(Me.Cells(FIRST_RECORD_ROW, COL_UUT), Me.Cells(Me.Rows.Count, COL_SUB_STEP_4))
    Set changedRange = Intersect(target, entryRange)

    If changedRange Is Nothing Then Exit Sub

    lastTrackedRow = GetLastTrackedRecordRow(changedRange)

    If lastTrackedRow < FIRST_RECORD_ROW Then Exit Sub

    Set boundedRange = Me.Range(Me.Cells(FIRST_RECORD_ROW, COL_UUT), Me.Cells(lastTrackedRow, COL_SUB_STEP_4))
    Set changedRange = Intersect(changedRange, boundedRange)

    If changedRange Is Nothing Then Exit Sub

    Set changedRows = CreateObject("Scripting.Dictionary")

    For Each changedArea In changedRange.Areas

        changedColumns = 0

        For columnNumber = changedArea.Column To changedArea.Column + changedArea.columns.Count - 1
            changedColumns = changedColumns Or CLng(2 ^ (columnNumber - COL_UUT))
        Next columnNumber

        firstChangedRow = changedArea.Row
        lastChangedRow = changedArea.Row + changedArea.Rows.Count - 1

        For rowNumber = firstChangedRow To lastChangedRow

            If changedRows.Exists(rowNumber) Then
                changedRows(rowNumber) = CLng(changedRows(rowNumber)) Or changedColumns
            Else
                changedRows(rowNumber) = changedColumns
            End If

        Next rowNumber

    Next changedArea

    If changedRows.Count = 0 Then Exit Sub

    previousEnableEvents = Application.EnableEvents
    previousScreenUpdating = Application.ScreenUpdating
    applicationStateSaved = True

    Application.EnableEvents = False
    Application.ScreenUpdating = False

    ' Row processing begins after the complete edit is known so explicitly supplied descendants remain available.
    For Each rowKey In changedRows.keys

        rowNumber = rowKey

        ProcessChangedRow rowNumber, CLng(changedRows(rowKey))

    Next rowKey


Cleanup:

    savedErrNumber = Err.Number
    savedErrDescription = Err.description

    If applicationStateSaved Then

        On Error Resume Next

        Application.ScreenUpdating = previousScreenUpdating
        Application.EnableEvents = previousEnableEvents

        On Error GoTo 0

    End If

    If savedErrNumber <> 0 Then

        MsgBox "Worksheet update failed." & vbCrLf & vbCrLf & _
            "Error " & CStr(savedErrNumber) & vbCrLf & savedErrDescription, _
            vbCritical, "TS Data Error"

    End If

End Sub


Private Sub Worksheet_BeforeDoubleClick(ByVal target As Range, Cancel As Boolean)

    If target.Row < FIRST_RECORD_ROW Then Exit Sub

    Select Case target.Column

        Case COL_UUT

            Cancel = True
            StartGuidedEntry target

        Case COL_SN

            Cancel = True
            OpenSerialNumberEntry target

        Case COL_FAILURE_TYPE To COL_SUB_STEP_4

            Cancel = True
            OpenPickerForCell target

        Case Else
            Exit Sub

    End Select

End Sub


'============================================================
' ROW PROCESSING
'============================================================

Private Sub ProcessChangedRow(ByVal rowNumber As Long, ByVal changedColumns As Long)

    Dim hierarchyChanged As Boolean
    Dim stateChanged As Boolean
    Dim hierarchySuppressed As Boolean

    If (changedColumns And CHANGE_UUT) <> 0 Then
        UpdateRecordDateFromUUT Me.Cells(rowNumber, COL_UUT)
    End If

    If (changedColumns And CHANGE_SN) <> 0 Then
        IgnoreCNNumberAsTextError Me.Cells(rowNumber, COL_SN)
    End If

    hierarchyChanged = (changedColumns And CHANGE_HIERARCHY_FIELDS) <> 0
    stateChanged = (changedColumns And CHANGE_STATE_FIELDS) <> 0

    If stateChanged Then

        ApplyFailureTypeState Me, rowNumber

        hierarchySuppressed = HierarchyIsSuppressedForRow(rowNumber)

        If hierarchyChanged And Not hierarchySuppressed Then
            ProcessHierarchyChanges rowNumber, changedColumns
        End If

    End If

    ApplyChangedCellThemes rowNumber, changedColumns, hierarchySuppressed

    If stateChanged Then
        ApplyHierarchyRowLayout Me, rowNumber
    End If

End Sub


Private Sub ProcessHierarchyChanges(ByVal rowNumber As Long, ByVal changedColumns As Long)

    Dim columnNumber As Long
    Dim columnFlag As Long
    Dim childFlag As Long
    Dim fieldName As String

    For columnNumber = COL_FIRST_HIERARCHY_FIELD To COL_LAST_HIERARCHY_FIELD

        columnFlag = CLng(2 ^ (columnNumber - COL_UUT))

        If (changedColumns And columnFlag) <> 0 Then

            fieldName = FieldNameFromColumn(columnNumber)

            If columnNumber <= COL_LAST_RECONCILE_FIELD Then

                childFlag = CLng(2 ^ ((columnNumber + 1) - COL_UUT))

                If (changedColumns And childFlag) = 0 Then
                    ReconcileAfterChange Me, rowNumber, fieldName
                ElseIf columnNumber >= COL_FIRST_NODE_SYNC_FIELD Then
                    SyncNodeIdentityForField Me, rowNumber, fieldName
                End If

            Else
                SyncNodeIdentityForField Me, rowNumber, fieldName
            End If

        End If

    Next columnNumber

End Sub


Private Sub ApplyChangedCellThemes(ByVal rowNumber As Long, ByVal changedColumns As Long, _
    ByVal hierarchySuppressed As Boolean)

    Dim columnNumber As Long
    Dim columnFlag As Long
    Dim fieldName As String

    For columnNumber = COL_UUT To COL_LAST_HIERARCHY_FIELD

        columnFlag = CLng(2 ^ (columnNumber - COL_UUT))

        If (changedColumns And columnFlag) <> 0 Then

            If Not (hierarchySuppressed And columnNumber >= COL_FIRST_HIERARCHY_FIELD) Then

                fieldName = FieldNameFromColumn(columnNumber)

                If Len(fieldName) > 0 Then
                    ApplyThemeToCell Me.Cells(rowNumber, columnNumber), fieldName
                End If

            End If

        End If

    Next columnNumber

End Sub


'============================================================
' RANGE BOUNDING
'============================================================

Private Function GetLastTrackedRecordRow(ByVal changedRange As Range) As Long

    Dim changedArea As Range
    Dim searchRange As Range
    Dim lastCell As Range
    Dim lastTrackedRow As Long
    Dim lastChangedRow As Long
    Dim firstNodeIDColumn As Long
    Dim lastNodeIDColumn As Long
    Dim fullEntryRowCount As Long

    lastTrackedRow = FIRST_RECORD_ROW - 1

    ' Visible record data and hidden Node IDs keep whole-column edits bounded to active records.
    Set searchRange = Me.Range(Me.Cells(FIRST_RECORD_ROW, COL_DATE), Me.Cells(Me.Rows.Count, COL_LAST_RECORD_FIELD))

    Set lastCell = searchRange.Find(What:="*", After:=searchRange.Cells(1, 1), _
        LookIn:=xlValues, LookAt:=xlPart, SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, MatchCase:=False, SearchFormat:=False)

    If Not lastCell Is Nothing Then
        lastTrackedRow = lastCell.Row
    End If

    firstNodeIDColumn = NodeIDColumn("Test Step")
    lastNodeIDColumn = NodeIDColumn("Sub Step 4")

    If firstNodeIDColumn > 0 And lastNodeIDColumn >= firstNodeIDColumn Then

        Set searchRange = Me.Range(Me.Cells(FIRST_RECORD_ROW, firstNodeIDColumn), _
            Me.Cells(Me.Rows.Count, lastNodeIDColumn))

        Set lastCell = searchRange.Find(What:="*", After:=searchRange.Cells(1, 1), _
            LookIn:=xlValues, LookAt:=xlPart, SearchOrder:=xlByRows, _
            SearchDirection:=xlPrevious, MatchCase:=False, SearchFormat:=False)

        If Not lastCell Is Nothing Then

            If lastCell.Row > lastTrackedRow Then
                lastTrackedRow = lastCell.Row
            End If

        End If

    End If

    fullEntryRowCount = Me.Rows.Count - FIRST_RECORD_ROW + 1

    ' Edge Case Defense:
    ' A finite target area preserves rows whose final stored values were removed by the edit.
    For Each changedArea In changedRange.Areas

        If changedArea.Rows.CountLarge < fullEntryRowCount Then

            lastChangedRow = changedArea.Row + changedArea.Rows.Count - 1

            If lastChangedRow > lastTrackedRow Then
                lastTrackedRow = lastChangedRow
            End If

        End If

    Next changedArea

    GetLastTrackedRecordRow = lastTrackedRow

End Function


'============================================================
' STATE HELPERS
'============================================================

Private Function HierarchyIsSuppressedForRow(ByVal rowNumber As Long) As Boolean

    Dim failureValue As Variant
    Dim failureType As String

    failureValue = Me.Cells(rowNumber, COL_FAILURE_TYPE).value2

    If IsError(failureValue) Or IsEmpty(failureValue) Then Exit Function

    failureType = Trim$(CStr(failureValue))

    If Len(failureType) = 0 Then Exit Function

    HierarchyIsSuppressedForRow = FailureTypeSuppressesTestHierarchy(failureType)

End Function


Private Sub UpdateRecordDateFromUUT(ByVal uutCell As Range)

    Dim dateCell As Range
    Dim recordDate As Date
    Dim uutValue As Variant

    Set dateCell = Me.Cells(uutCell.Row, COL_DATE)

    uutValue = uutCell.value2

    If IsError(uutValue) Then Exit Sub

    If Len(Trim$(CStr(uutValue))) = 0 Then

        dateCell.ClearContents

        Exit Sub

    End If

    If Not IsEmpty(dateCell.value2) Then Exit Sub

    recordDate = Date

    dateCell.NumberFormat = "dd""" & UCase$(Format$(recordDate, "mmm")) & """yyyy"
    dateCell.value2 = CDbl(recordDate)

End Sub


Private Sub IgnoreCNNumberAsTextError(ByVal cnCell As Range)

    If cnCell.Errors.item(xlNumberAsText).value Then
        cnCell.Errors.item(xlNumberAsText).Ignore = True
    End If

End Sub

