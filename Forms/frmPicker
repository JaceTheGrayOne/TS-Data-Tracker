        .Caption = "Confirm"
        .BackColor = UIColor_ButtonBackground()
        .ForeColor = UIColor_ButtonText()
        .Font.Name = UI_FONT
        .Font.Size = UI_BUTTON_FONT_SIZE
        .Font.Bold = False
        .Visible = False
        .Enabled = False
        .Default = False
        .Cancel = False
        .TabStop = False
        .TabIndex = txtSearch.TabIndex + 1

    End With

    PositionSearchHint
    UpdateSearchHint

End Sub
Private Sub UserForm_Activate()

    mKeyboardNavigationActive = False
    txtSearch.SetFocus

End Sub


Private Sub UserForm_QueryClose( _
    Cancel As Integer, _
    CloseMode As Integer _
)

    If mGuidedEntryMode And CloseMode = vbFormControlMenu Then

        Cancel = True
        CancelPicker

        Exit Sub

    End If

    ReleasePickerItems

    Set mSelectedItems = Nothing
    Set mBranchItems = Nothing
    Set mSelectionStatus = Nothing

End Sub


Private Sub ClosePicker()

    If mGuidedEntryMode Then
        Me.Hide
    Else
        Unload Me
    End If

End Sub


Private Sub CancelPicker()

    mSelectionConfirmed = False
    ClosePicker

End Sub


