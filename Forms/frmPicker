Option Explicit


'============================================================
' CONFIGURATION
'============================================================

Private Const STATUS_MULTIPLE_BRANCHES As String = "Only one branch can be selected"
Private Const STATUS_IDENTITY_UNAVAILABLE As String = "Selection identity is unavailable"


'============================================================
' MODULE STATE
'============================================================

Private mTarget As Range
Private mFieldName As String
Private mValues As Collection
Private mKeyboardIndex As Long
Private mTargetIDColumn As Long
Private mHandlers As Collection
Private mSuppressSearchChange As Boolean
Private mAllowMultipleSelection As Boolean
Private mKeyboardNavigationActive As Boolean
Private mGuidedEntryMode As Boolean
Private mSelectionConfirmed As Boolean

Private mSelectedItems As Object
Private mBranchItems As Object
Private mSelectedBranchCount As Long

Private mSelectionStatus As MSForms.Label


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub LoadPicker( _
    ByVal targetCell As Range, _
    ByVal fieldName As String, _
    ByVal values As Collection, _
    Optional ByVal contextText As String = "", _
    Optional ByVal targetIDColumn As Long = 0, _
    Optional ByVal allowMultipleSelection As Boolean = False, _
    Optional ByVal guidedEntryMode As Boolean = False _
)

    If targetCell Is Nothing Then Exit Sub
    If values Is Nothing Then Exit Sub

    Set mTarget = targetCell
    Set mValues = values

    mFieldName = fieldName
    mTargetIDColumn = targetIDColumn
    mAllowMultipleSelection = allowMultipleSelection
    mKeyboardNavigationActive = False
    mGuidedEntryMode = guidedEntryMode
    mSelectionConfirmed = False

    lblTitle.Caption = UCase$(fieldName)

    If Len(Trim$(contextText)) = 0 Then
        lblPath.Caption = "ROOT SELECTION"
    Else
        lblPath.Caption = contextText
    End If

    InitializeSelectionState

    ' Search is cleared without rebuilding the list between assignments.
    mSuppressSearchChange = True
    txtSearch.value = vbNullString
    mSuppressSearchChange = False

    UpdateSearchHint
    UpdateSelectionStatus
    SizePickerForContent mValues
    BuildItems

End Sub


Public Property Get SelectionConfirmed() As Boolean

    SelectionConfirmed = mSelectionConfirmed

End Property


Public Sub CommitValue(ByVal selectedValue As String, Optional ByVal selectedKey As String = "")

    If mTarget Is Nothing Then Exit Sub

    '----------------------------------------------------
    ' TREE-BACKED IDENTITY
    '----------------------------------------------------
    ' Node identity is written before the visible value so Worksheet_Change sees a synchronized pair.
    If mTargetIDColumn > 0 Then
        mTarget.Worksheet.Cells(mTarget.Row, mTargetIDColumn).value2 = selectedKey
    End If

    mTarget.value2 = selectedValue

    mSelectionConfirmed = True
    ClosePicker

End Sub


Public Sub HandleItemClick(ByVal selectedItem As clsPickerItem)

    If selectedItem Is Nothing Then Exit Sub

    HoverItem selectedItem

    If mAllowMultipleSelection Then

        ToggleItemSelection selectedItem

        txtSearch.SetFocus
        mKeyboardNavigationActive = True

        Exit Sub

    End If

    CommitValue selectedItem.itemValue, selectedItem.itemKey

End Sub
Public Sub HoverItem(ByVal hoveredItem As clsPickerItem)

    Dim itemIndex As Long
    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub

    For itemIndex = 1 To mHandlers.Count

        Set handler = mHandlers(itemIndex)

        If handler Is hoveredItem Then
            mKeyboardIndex = itemIndex
        End If

        handler.SetHovered (handler Is hoveredItem)

    Next itemIndex

End Sub


