        .Caption = "Search"
        .BackStyle = fmBackStyleTransparent
        .ForeColor = UIColor_TextMuted()
        .Font.Name = UI_FONT
        .Font.Size = UI_SEARCH_FONT_SIZE
        .Font.Bold = False
        .TextAlign = fmTextAlignCenter

    End With

    '----------------------------------------------------
    ' ITEM PANEL
    '----------------------------------------------------
