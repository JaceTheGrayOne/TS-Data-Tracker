Private Function MeasureSelectionStatusWidth() As Single

    Dim measureLabel As MSForms.Label
    Dim statusTexts As Variant
    Dim statusText As Variant
    Dim maximumWidth As Single
    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    On Error GoTo Fail

    Set measureLabel = Me.Controls.Add("Forms.Label.1", "lblSelectionStatusMeasureTemp", True)

    With measureLabel

        .Visible = False
        .AutoSize = True
        .WordWrap = False
        .Font.Name = UI_FONT
        .Font.Size = UI_STATUS_FONT_SIZE
        .Font.Bold = False

    End With

    statusTexts = Array(CStr(mValues.Count) & " Entries Selected", STATUS_MULTIPLE_BRANCHES, STATUS_IDENTITY_UNAVAILABLE)

    For Each statusText In statusTexts

        measureLabel.Caption = CStr(statusText)

