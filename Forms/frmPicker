        Me.Controls.Remove measureLabel.Name
    End If

    On Error GoTo 0

    Err.Raise savedErrNumber, "frmPicker.MeasureSelectionStatusWidth", savedErrDescription

End Function


' A temporary AutoSize label measures wrapped breadcrumb height because a fixed-width WordWrap label does not report it reliably.
Private Function MeasureWrappedBreadcrumbHeight( _
    ByVal textValue As String, _
    ByVal maximumWidth As Single _
) As Single

    Dim measureLabel As MSForms.Label
    Dim remainingText As String
    Dim candidateText As String
    Dim fitLength As Long
    Dim breakPosition As Long
    Dim characterIndex As Long
    Dim lineCount As Long
    Dim lineHeight As Single
    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    On Error GoTo Fail

    ' Edge Case Defense:
    ' A stale temporary measuring control can remain after an interrupted cleanup.
    On Error Resume Next
    Me.Controls.Remove "lblBreadcrumbMeasureTemp"
    On Error GoTo Fail

    Set measureLabel = Me.Controls.Add( _
        "Forms.Label.1", _
        "lblBreadcrumbMeasureTemp", _
        True)

    With measureLabel

        .Visible = False
        .AutoSize = True
        .WordWrap = False
        .Font.Name = lblPath.Font.Name
        .Font.Size = lblPath.Font.Size
        .Font.Bold = lblPath.Font.Bold

    End With

    measureLabel.Caption = "Ag"

    lineHeight = measureLabel.Height
    remainingText = Trim$(textValue)

    If Len(remainingText) = 0 Then

        MeasureWrappedBreadcrumbHeight = lineHeight

        GoTo Cleanup

    End If

    Do While Len(remainingText) > 0

        fitLength = 0

        For characterIndex = 1 To Len(remainingText)

            candidateText = Left$(remainingText, characterIndex)
            measureLabel.Caption = candidateText

            If measureLabel.Width <= maximumWidth Then
                fitLength = characterIndex
            Else
                Exit For
            End If

        Next characterIndex

        If fitLength >= Len(remainingText) Then

            lineCount = lineCount + 1

            Exit Do

        End If

        ' Edge Case Defense:
        ' At least one character must be assigned to each measured line.
        If fitLength < 1 Then fitLength = 1

        breakPosition = InStrRev(Left$(remainingText, fitLength), " ")

        If breakPosition > 1 Then
            fitLength = breakPosition - 1
        End If

        lineCount = lineCount + 1
        remainingText = LTrim$(Mid$(remainingText, fitLength + 1))

    Loop

    MeasureWrappedBreadcrumbHeight = lineCount * lineHeight

Cleanup:

    On Error Resume Next

    If Not measureLabel Is Nothing Then
        Me.Controls.Remove measureLabel.Name
    End If

    On Error GoTo 0

    Exit Function

Fail:

    savedErrNumber = Err.Number
    savedErrDescription = Err.description

    On Error Resume Next

    If Not measureLabel Is Nothing Then
        Me.Controls.Remove measureLabel.Name
    End If

    On Error GoTo 0

    Err.Raise savedErrNumber, "frmPicker.MeasureWrappedBreadcrumbHeight", savedErrDescription

End Function


Private Function MeasureLongestItemWidth(ByVal values As Collection) As Single

    Dim measureLabel As MSForms.Label
    Dim item As Variant
    Dim itemText As String
    Dim itemKey As String
    Dim maximumWidth As Single
    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    On Error GoTo Fail

    Set measureLabel = Me.Controls.Add( _
        "Forms.Label.1", _
        "lblMeasureTemp", _
        True)

    With measureLabel

        .Visible = False
        .AutoSize = True
        .WordWrap = False
        .Font.Name = UI_FONT
        .Font.Size = UI_ITEM_FONT_SIZE

    End With

    For Each item In values

        ResolvePickerItem item, itemText, itemKey

        measureLabel.Caption = "   " & itemText

        If measureLabel.Width > maximumWidth Then
            maximumWidth = measureLabel.Width
        End If

    Next item

    MeasureLongestItemWidth = maximumWidth

Cleanup:

    If Not measureLabel Is Nothing Then
        Me.Controls.Remove measureLabel.Name
    End If

    Exit Function

Fail:

    savedErrNumber = Err.Number
    savedErrDescription = Err.description

    On Error Resume Next

    If Not measureLabel Is Nothing Then
        Me.Controls.Remove measureLabel.Name
    End If

    On Error GoTo 0

    Err.Raise savedErrNumber, "frmPicker.MeasureLongestItemWidth", savedErrDescription

End Function


Private Sub ResolvePickerItem( _
    ByVal item As Variant, _
    ByRef itemText As String, _
    ByRef itemKey As String _
)

    Dim node As clsTestNode

    itemText = vbNullString
    itemKey = vbNullString

    If IsObject(item) Then

        If TypeName(item) <> "clsTestNode" Then

            Err.Raise _
                vbObjectError + 1800, _
                "frmPicker.ResolvePickerItem", _
                "Unsupported picker object type '" & TypeName(item) & "'."

        End If

        Set node = item

        itemText = node.Label
        itemKey = node.nodeID

    Else

        itemText = CStr(item)

    End If

End Sub

