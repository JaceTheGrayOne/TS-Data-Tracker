' CONTROL EVENTS
'============================================================

Private Sub txtSearch_Change()

    mKeyboardNavigationActive = False

    UpdateSearchHint

    If mSuppressSearchChange Then Exit Sub

    BuildItems

End Sub


Private Sub txtSearch_Enter()

    mKeyboardNavigationActive = False

End Sub


Private Sub txtSearch_MouseDown( _
    ByVal button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single _
)

    mKeyboardNavigationActive = False

End Sub


Private Sub lblSearchHint_Click()

    mKeyboardNavigationActive = False
    txtSearch.SetFocus

End Sub




Private Sub cmdConfirm_Click()

    If Not mAllowMultipleSelection Then Exit Sub
    If Not cmdConfirm.Enabled Then Exit Sub

    CommitSelectedValues

End Sub


Private Sub cmdConfirm_KeyDown(ByVal KeyCode As MSForms.ReturnInteger, ByVal Shift As Integer)

    If KeyCode <> vbKeyEscape Then Exit Sub

    CancelPicker
    KeyCode = 0

End Sub

Private Sub fraItems_MouseMove( _
    ByVal button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single _
)

    ClearItemHover

End Sub


Private Sub txtSearch_KeyDown(ByVal KeyCode As MSForms.ReturnInteger, ByVal Shift As Integer)

    Select Case KeyCode

        Case vbKeyDown

            mKeyboardNavigationActive = True
            MoveKeyboardSelection 1
            KeyCode = 0

        Case vbKeyUp

            mKeyboardNavigationActive = True
            MoveKeyboardSelection -1
            KeyCode = 0

        Case vbKeySpace

            If mAllowMultipleSelection And mKeyboardNavigationActive Then

                ToggleKeyboardSelection
                KeyCode = 0

            End If

        Case vbKeyReturn

            If mAllowMultipleSelection Then

                If cmdConfirm.Enabled Then
                    CommitSelectedValues
                End If

            Else

                CommitKeyboardSelection

            End If

            KeyCode = 0

        Case vbKeyEscape

            CancelPicker
            KeyCode = 0

        Case Else

            mKeyboardNavigationActive = False

    End Select

End Sub
'============================================================
' ITEM CONSTRUCTION
'============================================================

Private Sub BuildItems()

    Dim itemIndex As Long
    Dim visibleIndex As Long
    Dim selectedIndex As Long
    Dim restoredIndex As Long
    Dim item As Variant
    Dim itemText As String
    Dim itemKey As String
    Dim itemToken As String
    Dim searchText As String
    Dim keyboardToken As String
    Dim itemTop As Single
    Dim rowLeft As Single
    Dim rowWidth As Single
    Dim isSelected As Boolean
    Dim isBranch As Boolean
    Dim itemLabel As MSForms.Label
    Dim accentLabel As MSForms.Label
    Dim handler As clsPickerItem

    If mValues Is Nothing Then Exit Sub

    keyboardToken = CurrentKeyboardToken()

    ReleasePickerItems

    For itemIndex = fraItems.Controls.Count - 1 To 0 Step -1

        If Left$(fraItems.Controls(itemIndex).Name, Len("lblPicker")) = "lblPicker" Then
            fraItems.Controls.Remove fraItems.Controls(itemIndex).Name
        End If

    Next itemIndex

    Set mHandlers = New Collection

    searchText = Trim$(txtSearch.value)

    For Each item In mValues

        ResolvePickerItem item, itemText, itemKey

        itemToken = PickerSelectionToken(itemText, itemKey)
        isSelected = mSelectedItems.Exists(itemToken)

        If (mAllowMultipleSelection And isSelected) _
            Or Len(searchText) = 0 _
            Or InStr(1, itemText, searchText, vbTextCompare) > 0 Then

            visibleIndex = visibleIndex + 1

            itemTop = UI_ITEM_PANEL_PADDING + ((visibleIndex - 1) * (UI_ITEM_HEIGHT + UI_ITEM_GAP))
            rowLeft = UI_ITEM_PANEL_PADDING
            rowWidth = fraItems.InsideWidth - (UI_ITEM_PANEL_PADDING * 2)

            Set itemLabel = fraItems.Controls.Add( _
                "Forms.Label.1", _
                "lblPickerItem" & visibleIndex, _
                True)

            With itemLabel

                .Caption = "   " & itemText
                .Left = rowLeft
                .Top = itemTop
                .Width = rowWidth
                .Height = UI_ITEM_HEIGHT
                .BackStyle = fmBackStyleOpaque
                .BorderStyle = fmBorderStyleSingle
                .TextAlign = fmTextAlignLeft
                .Font.Name = UI_FONT
                .Font.Size = UI_ITEM_FONT_SIZE
                .Font.Bold = False
                .WordWrap = False

            End With

            ApplyUIPickerTheme itemLabel, mFieldName, itemText

            Set accentLabel = fraItems.Controls.Add( _
                "Forms.Label.1", _
                "lblPickerAccent" & visibleIndex, _
                True)

            With accentLabel

                .Caption = vbNullString
                .Left = rowLeft
                .Top = itemTop
                .Width = UI_ACCENT_WIDTH
                .Height = UI_ITEM_HEIGHT
                .BackStyle = fmBackStyleOpaque
                .BorderStyle = fmBorderStyleNone
                .Visible = False

            End With

            isBranch = False

            If mBranchItems.Exists(itemToken) Then
                isBranch = CBool(mBranchItems(itemToken))
            End If

            Set handler = New clsPickerItem

            handler.Initialize _
                itemLabel, _
                accentLabel, _
                itemText, _
                itemKey, _
                isBranch, _
                mAllowMultipleSelection, _
                Me

            handler.SetSelected isSelected

            If isSelected And selectedIndex = 0 Then
                selectedIndex = visibleIndex
            End If

            If Len(keyboardToken) > 0 Then

                If StrComp(itemToken, keyboardToken, vbTextCompare) = 0 Then
                    restoredIndex = visibleIndex
                End If

            End If

            mHandlers.Add handler

        End If

    Next item

    fraItems.ScrollTop = 0

    If visibleIndex > 0 Then

        fraItems.ScrollHeight = (UI_ITEM_PANEL_PADDING * 2) + _
            (visibleIndex * UI_ITEM_HEIGHT) + _
            ((visibleIndex - 1) * UI_ITEM_GAP)

    Else

        fraItems.ScrollHeight = fraItems.InsideHeight

    End If

    If visibleIndex = 0 Then

        mKeyboardIndex = 0

    ElseIf restoredIndex > 0 Then

        mKeyboardIndex = restoredIndex
        HighlightKeyboardItem

    ElseIf selectedIndex > 0 Then

        mKeyboardIndex = selectedIndex
        HighlightKeyboardItem

    Else

        mKeyboardIndex = 1
        HighlightKeyboardItem

    End If

End Sub


Private Sub ReleasePickerItems()

    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub

    For Each handler In mHandlers
        handler.Cleanup
    Next handler

    Set mHandlers = Nothing

End Sub


'============================================================
' SELECTION STATE
'============================================================

Private Sub InitializeSelectionState()

    Set mSelectedItems = CreateObject("Scripting.Dictionary")
    mSelectedItems.CompareMode = vbTextCompare

    Set mBranchItems = CreateObject("Scripting.Dictionary")
    mBranchItems.CompareMode = vbTextCompare

    LoadBranchMetadata
    LoadCurrentSelections
    RecountSelectedBranches

End Sub


Private Sub LoadBranchMetadata()

    Dim item As Variant
    Dim itemText As String
    Dim itemKey As String
    Dim itemToken As String
    Dim isBranch As Boolean

    For Each item In mValues

        ResolvePickerItem item, itemText, itemKey

        itemToken = PickerSelectionToken(itemText, itemKey)
        isBranch = False

        If mAllowMultipleSelection Then
            isBranch = HierarchyItemHasChildren(mFieldName, itemText, itemKey)
        End If

        mBranchItems(itemToken) = isBranch

    Next item

End Sub


Private Sub LoadCurrentSelections()

    Dim valueLines As Collection
    Dim nodeIDLines As Collection
    Dim item As Variant
    Dim itemText As String
    Dim itemKey As String
    Dim itemToken As String
    Dim currentValue As String
    Dim currentNodeIDs As String
    Dim useNodeIDs As Boolean
    Dim isSelected As Boolean

    currentValue = ReadRangeText(mTarget)

    If mTargetIDColumn > 0 Then
        currentNodeIDs = ReadRangeText(mTarget.Worksheet.Cells(mTarget.Row, mTargetIDColumn))
    End If

    Set valueLines = GetHierarchySelectionLines(currentValue)
    Set nodeIDLines = GetHierarchySelectionLines(currentNodeIDs)

    useNodeIDs = mTargetIDColumn > 0 _
        And nodeIDLines.Count > 0 _
        And nodeIDLines.Count = valueLines.Count

    For Each item In mValues

        ResolvePickerItem item, itemText, itemKey

        If useNodeIDs Then
            isSelected = CollectionContainsText(nodeIDLines, itemKey)
        Else
            isSelected = CollectionContainsText(valueLines, itemText)
        End If

        If isSelected Then

            itemToken = PickerSelectionToken(itemText, itemKey)

            If Not mSelectedItems.Exists(itemToken) Then
                mSelectedItems.Add itemToken, True
            End If

        End If

    Next item

End Sub


Private Sub ToggleItemSelection(ByVal selectedItem As clsPickerItem)

    Dim itemToken As String

    itemToken = PickerSelectionToken(selectedItem.itemValue, selectedItem.itemKey)

    If mSelectedItems.Exists(itemToken) Then

        mSelectedItems.Remove itemToken

    Else

        If selectedItem.isBranch And mSelectedBranchCount >= 1 Then

            ShowSelectionError STATUS_MULTIPLE_BRANCHES

            Exit Sub

        End If

        mSelectedItems.Add itemToken, True

    End If

    RecountSelectedBranches
    UpdateSelectionStatus
    BuildItems

End Sub
Private Sub RecountSelectedBranches()

    Dim itemToken As Variant

    mSelectedBranchCount = 0

    For Each itemToken In mSelectedItems.keys

        If mBranchItems.Exists(CStr(itemToken)) Then

            If CBool(mBranchItems(CStr(itemToken))) Then
                mSelectedBranchCount = mSelectedBranchCount + 1
            End If

        End If

    Next itemToken

End Sub


Private Sub CommitSelectedValues()

    Dim selectedValues As Collection
    Dim selectedKeys As Collection
    Dim item As Variant
    Dim itemText As String
    Dim itemKey As String
    Dim itemToken As String

    If mSelectedItems.Count = 0 Then Exit Sub

    If mSelectedBranchCount > 1 Then

        ShowSelectionError STATUS_MULTIPLE_BRANCHES

        Exit Sub

    End If

    Set selectedValues = New Collection
    Set selectedKeys = New Collection

    For Each item In mValues

        ResolvePickerItem item, itemText, itemKey

        itemToken = PickerSelectionToken(itemText, itemKey)

        If mSelectedItems.Exists(itemToken) Then

            selectedValues.Add itemText

            If mTargetIDColumn > 0 Then

                If Len(itemKey) = 0 Then

                    ShowSelectionError STATUS_IDENTITY_UNAVAILABLE

                    Exit Sub

                End If

                selectedKeys.Add itemKey

            End If

        End If

    Next item

    If selectedValues.Count = 0 Then Exit Sub

    If mTargetIDColumn > 0 Then

        CommitValue _
            JoinHierarchySelectionLines(selectedValues), _
            JoinHierarchySelectionLines(selectedKeys)

    Else

        CommitValue JoinHierarchySelectionLines(selectedValues)

    End If

End Sub
Private Sub UpdateSelectionStatus()

    If mSelectionStatus Is Nothing Then Exit Sub

    mSelectionStatus.Visible = mAllowMultipleSelection
    cmdConfirm.Visible = mAllowMultipleSelection
    cmdConfirm.TabStop = mAllowMultipleSelection

    If Not mAllowMultipleSelection Then

        cmdConfirm.Enabled = False
        cmdConfirm.Default = False

        Exit Sub

    End If

    mSelectionStatus.Caption = CStr(mSelectedItems.Count) & " Entries Selected"
    mSelectionStatus.ForeColor = UIColor_TextMuted()

    cmdConfirm.Enabled = (mSelectedItems.Count > 0)
    cmdConfirm.Default = cmdConfirm.Enabled

End Sub
Private Sub ShowSelectionError(ByVal errorText As String)

    If mSelectionStatus Is Nothing Then Exit Sub

    mSelectionStatus.Caption = errorText
    mSelectionStatus.ForeColor = UIColor_StatusError()
    mSelectionStatus.Visible = True

End Sub


Private Function PickerSelectionToken( _
    ByVal itemValue As String, _
    ByVal itemKey As String _
) As String

    itemKey = Trim$(itemKey)

    If Len(itemKey) > 0 Then
        PickerSelectionToken = "ID:" & itemKey
    Else
        PickerSelectionToken = "VALUE:" & Trim$(itemValue)
    End If

End Function


Private Function CollectionContainsText( _
    ByVal values As Collection, _
    ByVal searchValue As String _
) As Boolean

    Dim item As Variant

    searchValue = Trim$(searchValue)

    If Len(searchValue) = 0 Then Exit Function

    For Each item In values

        If StrComp(CStr(item), searchValue, vbTextCompare) = 0 Then

            CollectionContainsText = True

            Exit Function

        End If

    Next item

End Function


Private Function ReadRangeText(ByVal sourceCell As Range) As String

    Dim cellValue As Variant

    If sourceCell Is Nothing Then Exit Function

    cellValue = sourceCell.value2

    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function

    ReadRangeText = Trim$(CStr(cellValue))

End Function


'============================================================
' MOUSE HOVER
'============================================================

Private Sub ClearItemHover()

    Dim itemIndex As Long
    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub

    For itemIndex = 1 To mHandlers.Count

        Set handler = mHandlers(itemIndex)
        handler.SetHovered False

    Next itemIndex

End Sub


'============================================================
' KEYBOARD NAVIGATION
'============================================================

Private Sub MoveKeyboardSelection(ByVal direction As Long)

    If mHandlers Is Nothing Then Exit Sub
    If mHandlers.Count = 0 Then Exit Sub

    If mKeyboardIndex < 1 Then

        If direction > 0 Then
            mKeyboardIndex = 1
        Else
            mKeyboardIndex = mHandlers.Count
        End If

    Else

        mKeyboardIndex = mKeyboardIndex + direction

        If mKeyboardIndex > mHandlers.Count Then
            mKeyboardIndex = 1
        ElseIf mKeyboardIndex < 1 Then
            mKeyboardIndex = mHandlers.Count
        End If

    End If

    HighlightKeyboardItem

End Sub


Private Sub HighlightKeyboardItem()

    Dim itemIndex As Long
    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub

    For itemIndex = 1 To mHandlers.Count

        Set handler = mHandlers(itemIndex)
        handler.SetHovered (itemIndex = mKeyboardIndex)

    Next itemIndex

    EnsureKeyboardItemVisible

End Sub


Private Sub EnsureKeyboardItemVisible()

    Dim handler As clsPickerItem
    Dim itemTop As Single
    Dim itemBottom As Single
    Dim visibleTop As Single
    Dim visibleBottom As Single
    Dim newScrollTop As Single
    Dim maximumScrollTop As Single

    If mHandlers Is Nothing Then Exit Sub
    If mKeyboardIndex < 1 Or mKeyboardIndex > mHandlers.Count Then Exit Sub

    Set handler = mHandlers(mKeyboardIndex)

    itemTop = handler.itemLabel.Top
    itemBottom = itemTop + handler.itemLabel.Height

    visibleTop = fraItems.ScrollTop
    visibleBottom = visibleTop + fraItems.InsideHeight

    If itemTop < visibleTop Then

        fraItems.ScrollTop = itemTop

    ElseIf itemBottom > visibleBottom Then

        newScrollTop = itemBottom - fraItems.InsideHeight
        maximumScrollTop = fraItems.ScrollHeight - fraItems.InsideHeight

        If maximumScrollTop < 0 Then maximumScrollTop = 0
        If newScrollTop < 0 Then newScrollTop = 0
        If newScrollTop > maximumScrollTop Then newScrollTop = maximumScrollTop

        fraItems.ScrollTop = newScrollTop

    End If

End Sub


Private Sub ToggleKeyboardSelection()

    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub
    If mKeyboardIndex < 1 Or mKeyboardIndex > mHandlers.Count Then Exit Sub

    Set handler = mHandlers(mKeyboardIndex)

    ToggleItemSelection handler

End Sub


Private Sub CommitKeyboardSelection()

    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Sub
    If mKeyboardIndex < 1 Or mKeyboardIndex > mHandlers.Count Then Exit Sub

    Set handler = mHandlers(mKeyboardIndex)

    CommitValue handler.itemValue, handler.itemKey

End Sub


Private Function CurrentKeyboardToken() As String

    Dim handler As clsPickerItem

    If mHandlers Is Nothing Then Exit Function
    If mKeyboardIndex < 1 Or mKeyboardIndex > mHandlers.Count Then Exit Function

    Set handler = mHandlers(mKeyboardIndex)

    CurrentKeyboardToken = PickerSelectionToken(handler.itemValue, handler.itemKey)

End Function


'============================================================
' LAYOUT AND SIZING
'============================================================

Private Sub SizePickerForContent(ByVal values As Collection)

    Dim itemCount As Long
    Dim visibleCount As Long
    Dim longestTextWidth As Single
    Dim desiredInsideHeight As Single
    Dim desiredFrameInsideWidth As Single
    Dim desiredFormInsideWidth As Single
    Dim minimumFooterInsideWidth As Single
    Dim maximumFormInsideWidth As Single
    Dim frameChromeHeight As Single
    Dim frameChromeWidth As Single
    Dim formChromeHeight As Single
    Dim formChromeWidth As Single
    Dim desiredClientHeight As Single
    Dim footerBottom As Single
    Dim frameRightMargin As Single
    Dim searchRightMargin As Single
    Dim titleRightMargin As Single
    Dim pathRightMargin As Single
    Dim scrollAllowance As Single

    If values Is Nothing Then Exit Sub

    itemCount = values.Count

    frameRightMargin = Me.InsideWidth - (fraItems.Left + fraItems.Width)
    searchRightMargin = Me.InsideWidth - (txtSearch.Left + txtSearch.Width)
    titleRightMargin = Me.InsideWidth - (lblTitle.Left + lblTitle.Width)
    pathRightMargin = Me.InsideWidth - (lblPath.Left + lblPath.Width)

    frameChromeHeight = fraItems.Height - fraItems.InsideHeight
    frameChromeWidth = fraItems.Width - fraItems.InsideWidth

    formChromeHeight = Me.Height - Me.InsideHeight
    formChromeWidth = Me.Width - Me.InsideWidth

    visibleCount = itemCount

    If visibleCount < UI_PICKER_MIN_VISIBLE_ITEMS Then
        visibleCount = UI_PICKER_MIN_VISIBLE_ITEMS
    End If

    If visibleCount > UI_PICKER_MAX_VISIBLE_ITEMS Then
        visibleCount = UI_PICKER_MAX_VISIBLE_ITEMS
    End If

    desiredInsideHeight = (UI_ITEM_PANEL_PADDING * 2) + (visibleCount * UI_ITEM_HEIGHT)

    If visibleCount > 1 Then
        desiredInsideHeight = desiredInsideHeight + ((visibleCount - 1) * UI_ITEM_GAP)
    End If

    fraItems.Height = desiredInsideHeight + frameChromeHeight

    longestTextWidth = MeasureLongestItemWidth(values)

    If itemCount > UI_PICKER_MAX_VISIBLE_ITEMS Then
        scrollAllowance = UI_PICKER_SCROLLBAR_ALLOWANCE
    Else
        scrollAllowance = 0
    End If

    desiredFrameInsideWidth = (UI_ITEM_PANEL_PADDING * 2) + _
        longestTextWidth + _
        UI_PICKER_TEXT_RIGHT_PADDING + _
        scrollAllowance

    desiredFormInsideWidth = fraItems.Left + desiredFrameInsideWidth + frameChromeWidth + frameRightMargin

    If desiredFormInsideWidth < UI_PICKER_MIN_INSIDE_WIDTH Then
        desiredFormInsideWidth = UI_PICKER_MIN_INSIDE_WIDTH
    End If

    If mAllowMultipleSelection Then

        minimumFooterInsideWidth = fraItems.Left + MeasureSelectionStatusWidth() + _
            UI_PICKER_FOOTER_GAP + cmdConfirm.Width + frameRightMargin

        If desiredFormInsideWidth < minimumFooterInsideWidth Then
            desiredFormInsideWidth = minimumFooterInsideWidth
        End If

    End If

    maximumFormInsideWidth = Application.Width - formChromeWidth - (UI_PICKER_WINDOW_MARGIN * 2)

    If maximumFormInsideWidth < UI_PICKER_MIN_INSIDE_WIDTH Then
        maximumFormInsideWidth = UI_PICKER_MIN_INSIDE_WIDTH
    End If

    If desiredFormInsideWidth > maximumFormInsideWidth Then
        desiredFormInsideWidth = maximumFormInsideWidth
    End If

    Me.Width = desiredFormInsideWidth + formChromeWidth

    fraItems.Width = Me.InsideWidth - fraItems.Left - frameRightMargin
    txtSearch.Width = Me.InsideWidth - txtSearch.Left - searchRightMargin
    lblTitle.Width = Me.InsideWidth - lblTitle.Left - titleRightMargin
    lblPath.Width = Me.InsideWidth - lblPath.Left - pathRightMargin

    ResizeBreadcrumbLayout
    PositionSelectionStatus

    If mAllowMultipleSelection Then

        footerBottom = mSelectionStatus.Top + mSelectionStatus.Height

        If cmdConfirm.Top + cmdConfirm.Height > footerBottom Then
            footerBottom = cmdConfirm.Top + cmdConfirm.Height
        End If

        desiredClientHeight = footerBottom + UI_PICKER_BOTTOM_MARGIN

    Else

        desiredClientHeight = fraItems.Top + fraItems.Height + UI_PICKER_BOTTOM_MARGIN

    End If

    Me.Height = desiredClientHeight + formChromeHeight

End Sub
Private Sub ResizeBreadcrumbLayout()

    Dim originalPathHeight As Single
    Dim requiredPathHeight As Single
    Dim pathToSearchGap As Single
    Dim searchToPanelGap As Single

    originalPathHeight = lblPath.Height

    pathToSearchGap = txtSearch.Top - (lblPath.Top + lblPath.Height)
    searchToPanelGap = fraItems.Top - (txtSearch.Top + txtSearch.Height)

    requiredPathHeight = MeasureWrappedBreadcrumbHeight(lblPath.Caption, lblPath.Width)

    If requiredPathHeight < originalPathHeight Then
        requiredPathHeight = originalPathHeight
    End If

    lblPath.Height = requiredPathHeight
    txtSearch.Top = lblPath.Top + lblPath.Height + pathToSearchGap

    PositionSearchHint

    fraItems.Top = txtSearch.Top + txtSearch.Height + searchToPanelGap

End Sub


Private Sub PositionSearchHint()

    With lblSearchHint

        .Left = txtSearch.Left
        .Top = txtSearch.Top
        .Width = txtSearch.Width
        .Height = txtSearch.Height
        .TextAlign = fmTextAlignCenter

    End With

End Sub


Private Sub PositionSelectionStatus()

    If mSelectionStatus Is Nothing Then Exit Sub

    cmdConfirm.Left = fraItems.Left + fraItems.Width - cmdConfirm.Width
    cmdConfirm.Top = fraItems.Top + fraItems.Height + UI_PICKER_FOOTER_GAP

    With mSelectionStatus

        .Left = fraItems.Left
        .Width = cmdConfirm.Left - UI_PICKER_FOOTER_GAP - .Left
        .Height = UI_STATUS_HEIGHT
        .Top = cmdConfirm.Top + ((cmdConfirm.Height - .Height) / 2)

    End With

End Sub
Private Sub UpdateSearchHint()

    lblSearchHint.Visible = (Len(txtSearch.value) = 0)

End Sub


