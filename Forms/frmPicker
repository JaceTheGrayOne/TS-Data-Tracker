    With mSelectionStatus

        .Caption = vbNullString
        .BackStyle = fmBackStyleTransparent
        .ForeColor = UIColor_TextMuted()
        .Font.Name = UI_FONT
        .Font.Size = UI_STATUS_FONT_SIZE
        .Font.Bold = False
        .TextAlign = fmTextAlignLeft
        .Visible = False

    End With

