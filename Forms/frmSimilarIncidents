        CreateSimilarIncidentLabel( _
            "lblSimilarSource", _
            "CURRENT INCIDENT", _
            FORM_MARGIN, _
            SOURCE_LABEL_TOP, _
            contentWidth, _
            14)

    StyleSimilarIncidentSectionLabel mSourceLabel

    Set mSourceText = _
        CreateSimilarIncidentTextBox( _
            "txtSimilarSource", _
            FORM_MARGIN, _
            SOURCE_TEXT_TOP, _
            contentWidth, _
            SOURCE_TEXT_HEIGHT)

    StyleSimilarIncidentReadOnlyTextBox mSourceText

    '----------------------------------------------------
    ' RESULT LIST
    '----------------------------------------------------
