'============================================================
' MODULE STATE
'============================================================

Private mMatches As Collection
Private mLoadingResults As Boolean


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Function LoadForSelection(ByVal sourceCell As Range) As Boolean

    Dim sourceSummary As String

    Dim sourceCriteriaCount As Long
    Dim recordsEvaluated As Long

    Dim errorNumber As Long
    Dim errorDescription As String

    On Error GoTo LoadFailed

    Set mMatches = FindSimilarIncidents( _
        sourceCell, _
        sourceSummary, _
        sourceCriteriaCount, _
        recordsEvaluated)

    mSourceText.value = sourceSummary

    PopulateIncidentResults

    LoadForSelection = True

    Exit Function


LoadFailed:

    errorNumber = Err.Number
    errorDescription = Err.description

    Set mMatches = Nothing

    mSourceText.value = vbNullString
    mResultsList.Clear
    mPreviewText.value = "No similarity results are available for the selected row."
    mOpenButton.Enabled = False

    MsgBox _
        "Similar incidents could not be evaluated." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(errorNumber) & _
        vbCrLf & _
        errorDescription, _
        vbCritical, _
        "Similar Incidents"

End Function


'============================================================
' USERFORM LIFECYCLE
'============================================================

Private Sub UserForm_Initialize()

    Me.Caption = UI_APP_CAPTION
    Me.BackColor = UIColor_FormBackground()

    Me.Width = FORM_WIDTH
    Me.Height = FORM_HEIGHT
    Me.StartUpPosition = 1

    BuildSimilarIncidentInterface

End Sub


Private Sub UserForm_Activate()

    If mResultsList.ListCount > 0 Then
        mResultsList.SetFocus
    End If

End Sub


'============================================================
' CONTROL EVENTS
'============================================================

Private Sub mResultsList_Change()

    If mLoadingResults Then Exit Sub

    UpdateSelectedIncidentPreview

End Sub


Private Sub mRefreshButton_Click()

    Dim sourceCell As Range
    Dim failureReason As String

    If Not TryResolveSimilarIncidentSource(ActiveCell, sourceCell, failureReason) Then

        MsgBox failureReason, vbInformation, "Similar Incidents"

        Exit Sub

    End If

    LoadForSelection sourceCell

End Sub


Private Sub mOpenButton_Click()

    Dim selectedMatch As clsIncidentMatch

    Set selectedMatch = SelectedIncidentMatch()

    If selectedMatch Is Nothing Then Exit Sub

    OpenSimilarIncidentRow selectedMatch.WorksheetRow

End Sub


Private Sub mCloseButton_Click()

    Unload Me

End Sub


'============================================================
' INTERFACE CONSTRUCTION
'============================================================

Private Sub BuildSimilarIncidentInterface()

    Dim contentWidth As Single
    Dim previewLeft As Single
    Dim previewWidth As Single

    Dim closeLeft As Single
    Dim openLeft As Single
    Dim refreshLeft As Single

    Dim headerLeft As Single
    Dim headerRow As MSForms.Label

    contentWidth = Me.InsideWidth - (FORM_MARGIN * 2)

    previewLeft = FORM_MARGIN + RESULT_LIST_WIDTH + SECTION_GAP
    previewWidth = contentWidth - RESULT_LIST_WIDTH - SECTION_GAP

    closeLeft = Me.InsideWidth - FORM_MARGIN - BUTTON_WIDTH
    openLeft = closeLeft - BUTTON_GAP - BUTTON_WIDTH
    refreshLeft = openLeft - BUTTON_GAP - BUTTON_WIDTH

    '----------------------------------------------------
    ' TITLE
    '----------------------------------------------------
    Set mTitleLabel = CreateSimilarIncidentLabel( _
        "lblSimilarTitle", _
        "SIMILAR INCIDENTS", _
        FORM_MARGIN, _
        TITLE_TOP, _
        contentWidth, _
        TITLE_HEIGHT)

    With mTitleLabel
        .ForeColor = UIColor_TextPrimary()
        .Font.Size = UI_TITLE_FONT_SIZE
        .Font.Bold = True
    End With

    '----------------------------------------------------
    ' SOURCE RECORD
    '----------------------------------------------------
    Set mSourceLabel = CreateSimilarIncidentLabel( _
        "lblSimilarSource", _
        "CURRENT INCIDENT", _
        FORM_MARGIN, _
        SOURCE_LABEL_TOP, _
        contentWidth, _
        14)

    StyleSimilarIncidentSectionLabel mSourceLabel

    Set mSourceText = CreateSimilarIncidentTextBox( _
        "txtSimilarSource", _
        FORM_MARGIN, _
        SOURCE_TEXT_TOP, _
        contentWidth, _
        SOURCE_TEXT_HEIGHT)

    StyleSimilarIncidentReadOnlyTextBox mSourceText

    '----------------------------------------------------
    ' RESULT LIST
    '----------------------------------------------------
    Set mResultsLabel = CreateSimilarIncidentLabel( _
        "lblSimilarResults", _
        "MATCHES", _
        FORM_MARGIN, _
        CONTENT_LABEL_TOP, _
        RESULT_LIST_WIDTH, _
        14)

    StyleSimilarIncidentSectionLabel mResultsLabel

    Set headerRow = CreateSimilarIncidentLabel( _
        "lblSimilarHeaderRow", _
        vbNullString, _
        FORM_MARGIN, _
        CONTENT_TOP, _
        RESULT_LIST_WIDTH, _
        RESULT_HEADER_HEIGHT)

    With headerRow
        .BackStyle = fmBackStyleOpaque
        .BackColor = UIColor_PanelBackground()
        .BorderStyle = fmBorderStyleSingle
        .BorderColor = UIColor_InputBorder()
    End With

    headerLeft = FORM_MARGIN

    CreateSimilarIncidentColumnHeader _
        "lblSimilarScoreHeader", _
        "SCORE", _
        headerLeft, _
        RESULT_SCORE_COLUMN_WIDTH

    headerLeft = headerLeft + RESULT_SCORE_COLUMN_WIDTH

    CreateSimilarIncidentColumnHeader _
        "lblSimilarRowHeader", _
        "ROW", _
        headerLeft, _
        RESULT_ROW_COLUMN_WIDTH

    headerLeft = headerLeft + RESULT_ROW_COLUMN_WIDTH

    CreateSimilarIncidentColumnHeader _
        "lblSimilarUUTHeader", _
        "UUT", _
        headerLeft, _
        RESULT_UUT_COLUMN_WIDTH

    headerLeft = headerLeft + RESULT_UUT_COLUMN_WIDTH

    CreateSimilarIncidentColumnHeader _
        "lblSimilarTestHeader", _
        "TEST", _
        headerLeft, _
        RESULT_TEST_COLUMN_WIDTH

    headerLeft = headerLeft + RESULT_TEST_COLUMN_WIDTH

    CreateSimilarIncidentColumnHeader _
        "lblSimilarSummaryHeader", _
        "FAULT / PATH", _
        headerLeft, _
        RESULT_SUMMARY_COLUMN_WIDTH

    Set mResultsList = Me.Controls.Add( _
        "Forms.ListBox.1", _
        "lstSimilarResults", _
        True)

    With mResultsList
        .Left = FORM_MARGIN
        .Top = CONTENT_TOP + RESULT_HEADER_HEIGHT + RESULT_HEADER_GAP

        .Width = RESULT_LIST_WIDTH
        .IntegralHeight = False
        .Height = CONTENT_HEIGHT - RESULT_HEADER_HEIGHT - RESULT_HEADER_GAP

        .BackColor = UIColor_InputBackground()
        .ForeColor = UIColor_TextPrimary()
        .BorderStyle = fmBorderStyleSingle

        .Font.Name = UI_FONT
        .Font.Size = UI_ITEM_FONT_SIZE

        .ColumnCount = 5
        .ColumnWidths = _
            CStr(RESULT_SCORE_COLUMN_WIDTH) & " pt;" & _
            CStr(RESULT_ROW_COLUMN_WIDTH) & " pt;" & _
            CStr(RESULT_UUT_COLUMN_WIDTH) & " pt;" & _
            CStr(RESULT_TEST_COLUMN_WIDTH) & " pt;" & _
            CStr(RESULT_SUMMARY_LIST_WIDTH) & " pt"

        .MultiSelect = fmMultiSelectSingle
        .ListStyle = fmListStylePlain
        .ControlTipText = "Select a historical record to review its match explanation."
    End With

    '----------------------------------------------------
    ' PREVIEW
    '----------------------------------------------------
    Set mPreviewLabel = CreateSimilarIncidentLabel( _
        "lblSimilarPreview", _
        "SELECTED RECORD", _
        previewLeft, _
        CONTENT_LABEL_TOP, _
        previewWidth, _
        14)

    StyleSimilarIncidentSectionLabel mPreviewLabel

    Set mPreviewText = CreateSimilarIncidentTextBox( _
        "txtSimilarPreview", _
        previewLeft, _
        CONTENT_TOP, _
        previewWidth, _
        CONTENT_HEIGHT)

    StyleSimilarIncidentReadOnlyTextBox mPreviewText

    '----------------------------------------------------
    ' COMMANDS
    '----------------------------------------------------
    Set mRefreshButton = CreateSimilarIncidentButton( _
        "cmdSimilarRefresh", _
        "Refresh", _
        refreshLeft, _
        BUTTON_TOP)

    Set mOpenButton = CreateSimilarIncidentButton( _
        "cmdSimilarOpen", _
        "Open Record", _
        openLeft, _
        BUTTON_TOP)

    Set mCloseButton = CreateSimilarIncidentButton( _
        "cmdSimilarClose", _
        "Close", _
        closeLeft, _
        BUTTON_TOP)

    mRefreshButton.ControlTipText = "Recalculate matches from the currently selected TS Data row."
    mOpenButton.ControlTipText = "Open the selected historical record on TS Data."
    mCloseButton.ControlTipText = "Close Similar Incidents."

    mOpenButton.Enabled = False
    mOpenButton.Default = True
    mCloseButton.Cancel = True

    mPreviewText.value = "Select a ranked record to review why it matched."

End Sub


Private Function CreateSimilarIncidentLabel( _
    ByVal controlName As String, _
    ByVal captionText As String, _
    ByVal leftPosition As Single, _
    ByVal topPosition As Single, _
    ByVal controlWidth As Single, _
    ByVal controlHeight As Single _
) As MSForms.Label

    Dim lbl As MSForms.Label

    Set lbl = Me.Controls.Add("Forms.Label.1", controlName, True)

    With lbl
        .Caption = captionText
        .Left = leftPosition
        .Top = topPosition
        .Width = controlWidth
        .Height = controlHeight
        .BackStyle = fmBackStyleTransparent
        .Font.Name = UI_FONT
        .Font.Size = UI_ITEM_FONT_SIZE
    End With

    Set CreateSimilarIncidentLabel = lbl

End Function


Private Function CreateSimilarIncidentTextBox( _
    ByVal controlName As String, _
    ByVal leftPosition As Single, _
    ByVal topPosition As Single, _
    ByVal controlWidth As Single, _
    ByVal controlHeight As Single _
) As MSForms.TextBox

    Dim txt As MSForms.TextBox

    Set txt = Me.Controls.Add("Forms.TextBox.1", controlName, True)

    With txt
        .Left = leftPosition
        .Top = topPosition
        .Width = controlWidth
        .Multiline = True
        .IntegralHeight = False
        .Height = controlHeight
        .WordWrap = True
        .ScrollBars = fmScrollBarsVertical
        .Locked = True
        .TabStop = False
    End With

    Set CreateSimilarIncidentTextBox = txt

End Function


Private Function CreateSimilarIncidentButton( _
    ByVal controlName As String, _
    ByVal captionText As String, _
    ByVal leftPosition As Single, _
    ByVal topPosition As Single _
) As MSForms.CommandButton

    Dim button As MSForms.CommandButton

    Set button = Me.Controls.Add("Forms.CommandButton.1", controlName, True)

    With button
        .Caption = captionText
        .Left = leftPosition
        .Top = topPosition
        .Width = BUTTON_WIDTH
        .Height = BUTTON_HEIGHT
        .BackColor = UIColor_ButtonBackground()
        .ForeColor = UIColor_ButtonText()
        .Font.Name = UI_FONT
        .Font.Size = UI_BUTTON_FONT_SIZE
        .Font.Bold = False
    End With

    Set CreateSimilarIncidentButton = button

End Function


Private Sub CreateSimilarIncidentColumnHeader( _
    ByVal controlName As String, _
    ByVal captionText As String, _
    ByVal columnLeft As Single, _
    ByVal columnWidth As Single _
)

    Dim lbl As MSForms.Label

    Set lbl = CreateSimilarIncidentLabel( _
        controlName, _
        captionText, _
        columnLeft, _
        CONTENT_TOP, _
        columnWidth, _
        RESULT_HEADER_HEIGHT)

    With lbl
        .BackStyle = fmBackStyleTransparent
        .ForeColor = UIColor_TextMuted()
        .BorderStyle = fmBorderStyleNone

        .Font.Name = UI_FONT
        .Font.Size = UI_PATH_FONT_SIZE
        .Font.Bold = True

        .WordWrap = False
        .AutoSize = True

        .Left = columnLeft + ((columnWidth - .Width) / 2)
        .Top = CONTENT_TOP + ((RESULT_HEADER_HEIGHT - .Height) / 2)
    End With

End Sub


Private Sub StyleSimilarIncidentSectionLabel(ByVal lbl As MSForms.Label)

    With lbl
        .ForeColor = UIColor_TextMuted()
        .Font.Size = UI_PATH_FONT_SIZE
        .Font.Bold = True
    End With

End Sub


Private Sub StyleSimilarIncidentReadOnlyTextBox(ByVal txt As MSForms.TextBox)

    With txt
        .BackColor = UIColor_PanelBackground()
        .ForeColor = UIColor_TextPrimary()
        .BorderStyle = fmBorderStyleSingle
        .BorderColor = UIColor_InputBorder()
        .Font.Name = UI_FONT
        .Font.Size = UI_ITEM_FONT_SIZE
    End With

End Sub


'============================================================
' RESULT DISPLAY
'============================================================

Private Sub PopulateIncidentResults()

    Dim match As clsIncidentMatch
    Dim matchIndex As Long
    Dim listRow As Long

    mLoadingResults = True

    mResultsList.Clear
    mPreviewText.value = vbNullString
    mOpenButton.Enabled = False

    If mMatches Is Nothing Then

        mPreviewText.value = "No records were returned by the matching engine."

        mLoadingResults = False

        Exit Sub

    End If

    For matchIndex = 1 To mMatches.Count

        Set match = mMatches(matchIndex)

        mResultsList.AddItem CStr(match.Score) & "%"

        listRow = mResultsList.ListCount - 1

        mResultsList.List(listRow, 1) = CStr(match.WorksheetRow)
        mResultsList.List(listRow, 2) = match.UUT
        mResultsList.List(listRow, 3) = match.testName
        mResultsList.List(listRow, 4) = IncidentListSummary(match)

    Next matchIndex

    If mMatches.Count = 0 Then

        mPreviewText.value = "No records met the minimum similarity threshold."

    Else

        mResultsList.ListIndex = 0

    End If

    mLoadingResults = False

    UpdateSelectedIncidentPreview

End Sub


Private Sub UpdateSelectedIncidentPreview()

    Dim selectedMatch As clsIncidentMatch

    Set selectedMatch = SelectedIncidentMatch()

    If selectedMatch Is Nothing Then

        mOpenButton.Enabled = False

        If mResultsList.ListCount > 0 Then
            mPreviewText.value = "Select a ranked record to review why it matched."
        End If

        Exit Sub

    End If

    mOpenButton.Enabled = True
    mPreviewText.value = BuildIncidentPreview(selectedMatch)

End Sub


Private Function SelectedIncidentMatch() As clsIncidentMatch

    If mMatches Is Nothing Then Exit Function
    If mResultsList.ListIndex < 0 Then Exit Function

    Set SelectedIncidentMatch = mMatches(mResultsList.ListIndex + 1)

End Function


Private Function IncidentListSummary(ByVal match As clsIncidentMatch) As String

    If Len(match.FaultText) > 0 Then

        IncidentListSummary = match.FaultText

    ElseIf Len(match.TestPath) > 0 Then

        IncidentListSummary = match.TestPath

    Else

        IncidentListSummary = "No fault summary"

    End If

End Function


Private Function BuildIncidentPreview(ByVal match As clsIncidentMatch) As String

    Dim previewText As String

    previewText = match.MatchLevel & "    " & CStr(match.Score) & "%"

    previewText = previewText & vbCrLf & vbCrLf & _
        "WHY THIS MATCHED" & vbCrLf & _
        DisplayPreviewValue(match.reasonsText)

    previewText = previewText & vbCrLf & vbCrLf & _
        "RECORD" & vbCrLf & _
        "Worksheet Row: " & CStr(match.WorksheetRow) & vbCrLf & _
        "Date: " & DisplayPreviewValue(match.DateText) & vbCrLf & _
        "UUT: " & DisplayPreviewValue(match.UUT) & vbCrLf & _
        "SN: " & DisplayPreviewValue(match.serialNumber) & vbCrLf & _
        "Test: " & DisplayPreviewValue(match.testName) & vbCrLf & _
        "Path: " & DisplayPreviewValue(match.TestPath)

    previewText = previewText & vbCrLf & vbCrLf & _
        "FAULT" & vbCrLf & _
        DisplayPreviewValue(match.FaultText)

    previewText = previewText & vbCrLf & vbCrLf & _
        "CAUSE" & vbCrLf & _
        DisplayPreviewValue(match.CauseText)

    previewText = previewText & vbCrLf & vbCrLf & _
        "RESOLUTION" & vbCrLf & _
        DisplayPreviewValue(match.ResolutionText)

    previewText = previewText & vbCrLf & vbCrLf & _
        "NOTES" & vbCrLf & _
        DisplayPreviewValue(match.NotesText)

    If Len(match.differencesText) > 0 Then

        previewText = previewText & vbCrLf & vbCrLf & _
            "MATERIAL DIFFERENCES" & vbCrLf & _
            match.differencesText

    End If

    BuildIncidentPreview = previewText

End Function


Private Function DisplayPreviewValue(ByVal sourceText As String) As String

    If Len(Trim$(sourceText)) = 0 Then

        DisplayPreviewValue = "(blank)"

    Else

        DisplayPreviewValue = sourceText

    End If

End Function

