'============================================================
' RESULT DISPLAY
'============================================================

Private Sub PopulateIncidentResults()

    Dim match As clsIncidentMatch
    Dim matchIndex As Long
    Dim listRow As Long

    mLoadingResults = True

    mResultsList.Clear
    mPreviewText.value = vbNullString
    mOpenButton.Enabled = False

    If mMatches Is Nothing Then

        mStatusLabel.Caption = "No matches are available."
        mPreviewText.value = _
            "No records were returned by the matching engine."

        mLoadingResults = False

        Exit Sub

    End If

    For matchIndex = 1 To mMatches.Count

        Set match = mMatches(matchIndex)

        mResultsList.AddItem CStr(matchIndex)

        listRow = mResultsList.ListCount - 1

        mResultsList.List(listRow, 1) = CStr(match.Score) & "%"
        mResultsList.List(listRow, 2) = CStr(match.worksheetRow)
        mResultsList.List(listRow, 3) = match.UUT
        mResultsList.List(listRow, 4) = match.TestName
        mResultsList.List(listRow, 5) = IncidentListSummary(match)

    Next matchIndex

    mStatusLabel.Caption = _
        vbNullString

    If mMatches.Count = 0 Then

        mPreviewText.value = _
            "No records met the minimum similarity threshold."

    Else

        mResultsList.ListIndex = 0

    End If

    mLoadingResults = False

    UpdateSelectedIncidentPreview

End Sub


Private Sub UpdateSelectedIncidentPreview()

    Dim selectedMatch As clsIncidentMatch

    Set selectedMatch = SelectedIncidentMatch()

    If selectedMatch Is Nothing Then

        mOpenButton.Enabled = False

        If mResultsList.ListCount > 0 Then

            mPreviewText.value = _
                "Select a ranked record to review why it matched."

        End If

        Exit Sub

    End If

    mOpenButton.Enabled = True
    mPreviewText.value = BuildIncidentPreview(selectedMatch)

End Sub


Private Function SelectedIncidentMatch() As clsIncidentMatch

    Dim matchIndex As Long

    If mMatches Is Nothing Then
        Exit Function
    End If

    If mResultsList.ListIndex < 0 Then
        Exit Function
    End If

    matchIndex = _
        CLng( _
            mResultsList.List( _
                mResultsList.ListIndex, _
                0))

    If matchIndex < 1 _
        Or matchIndex > mMatches.Count Then

        Exit Function

    End If

    Set SelectedIncidentMatch = mMatches(matchIndex)

End Function


Private Function IncidentListSummary( _
    ByVal match As clsIncidentMatch _
) As String

    If Len(match.FaultText) > 0 Then

        IncidentListSummary = match.FaultText

    ElseIf Len(match.TestPath) > 0 Then

        IncidentListSummary = match.TestPath

    Else

        IncidentListSummary = "No fault summary"

    End If

End Function


Private Function BuildIncidentPreview( _
    ByVal match As clsIncidentMatch _
) As String

    Dim previewText As String

    AppendPreviewLine _
        previewText, _
        match.MatchLevel & _
        "    " & _
        CStr(match.Score) & _
        "%"

    AppendPreviewSection previewText, "WHY THIS MATCHED"
    AppendPreviewLine previewText, DisplayPreviewValue(match.reasonsText)

    AppendPreviewSection previewText, "RECORD"

    AppendPreviewLine _
        previewText, _
        "Worksheet Row: " & _
        CStr(match.worksheetRow)

    AppendPreviewField previewText, "Date", match.DateText
    AppendPreviewField previewText, "UUT", match.UUT
    AppendPreviewField previewText, "SN", match.SerialNumber
    AppendPreviewField previewText, "Test", match.TestName
    AppendPreviewField previewText, "Path", match.TestPath

    AppendPreviewSection previewText, "FAULT"
    AppendPreviewLine previewText, DisplayPreviewValue(match.FaultText)

    AppendPreviewSection previewText, "CAUSE"
    AppendPreviewLine previewText, DisplayPreviewValue(match.CauseText)

    AppendPreviewSection previewText, "RESOLUTION"
    AppendPreviewLine previewText, DisplayPreviewValue(match.ResolutionText)

    AppendPreviewSection previewText, "NOTES"
    AppendPreviewLine previewText, DisplayPreviewValue(match.NotesText)

    If Len(match.differencesText) > 0 Then

        AppendPreviewSection previewText, "MATERIAL DIFFERENCES"
        AppendPreviewLine previewText, match.differencesText

    End If

    BuildIncidentPreview = previewText

End Function


Private Sub AppendPreviewSection( _
    ByRef previewText As String, _
    ByVal sectionName As String _
)

    If Len(previewText) > 0 Then
        previewText = previewText & vbCrLf & vbCrLf
    End If

    previewText = previewText & sectionName

End Sub


Private Sub AppendPreviewField( _
    ByRef previewText As String, _
    ByVal fieldName As String, _
    ByVal fieldValue As String _
)

    AppendPreviewLine _
        previewText, _
        fieldName & _
        ": " & _
        DisplayPreviewValue(fieldValue)

End Sub


Private Sub AppendPreviewLine( _
    ByRef previewText As String, _
    ByVal lineText As String _
)

    If Len(previewText) > 0 Then
        previewText = previewText & vbCrLf
    End If

    previewText = previewText & lineText

End Sub


Private Function DisplayPreviewValue( _
    ByVal sourceText As String _
) As String

    If Len(Trim$(sourceText)) = 0 Then

        DisplayPreviewValue = "(blank)"

    Else

        DisplayPreviewValue = sourceText

    End If

End Function


