        CreateSimilarIncidentLabel( _
            "lblSimilarTitle", _
            "SIMILAR INCIDENTS", _
            FORM_MARGIN, _
            TITLE_TOP, _
            contentWidth, _
            TITLE_HEIGHT)

    With mTitleLabel
        .ForeColor = UIColor_TextPrimary()
        .Font.Size = UI_TITLE_FONT_SIZE
