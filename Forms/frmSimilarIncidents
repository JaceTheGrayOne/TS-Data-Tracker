    Set headerLabel = _
        CreateSimilarIncidentLabel( _
            "lblSimilarScoreHeader", _
            "SCORE", _
            headerLeft, _
            CONTENT_TOP, _
            RESULT_SCORE_COLUMN_WIDTH, _
            RESULT_HEADER_HEIGHT)

    StyleSimilarIncidentColumnHeader headerLabel

    headerLeft = _
        headerLeft + _
