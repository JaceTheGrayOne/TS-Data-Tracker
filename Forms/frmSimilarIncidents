        CreateSimilarIncidentLabel( _
            "lblSimilarResults", _
            "MATCHES", _
            FORM_MARGIN, _
            CONTENT_LABEL_TOP, _
            RESULT_LIST_WIDTH, _
            14)

    StyleSimilarIncidentSectionLabel mResultsLabel

    headerLeft = _
