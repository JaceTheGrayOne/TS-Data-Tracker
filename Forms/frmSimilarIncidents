'============================================================
' PUBLIC INTERFACE
'============================================================

Public Function LoadForSelection( _
    ByVal sourceCell As Range _
) As Boolean

    Dim sourceSummary As String

    Dim errorNumber As Long
    Dim errorDescription As String

    On Error GoTo LoadFailed

    Set mSourceCell = sourceCell

    Set mMatches = _
        FindSimilarIncidents( _
            mSourceCell, _
            sourceSummary, _
            mSourceCriteriaCount, _
            mRecordsEvaluated)

    mSourceText.value = sourceSummary

    PopulateIncidentResults

    LoadForSelection = True

    Exit Function


LoadFailed:

    errorNumber = Err.Number
    errorDescription = Err.Description

    Set mMatches = Nothing

    mSourceText.value = vbNullString
    mResultsList.Clear
    mPreviewText.value = _
        "No similarity results are available for the selected row."
    mStatusLabel.Caption = vbNullString
    mOpenButton.Enabled = False

    MsgBox _
        "Similar incidents could not be evaluated." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(errorNumber) & _
        vbCrLf & _
        errorDescription, _
        vbCritical, _
        "Similar Incidents"

End Function


'============================================================
' USERFORM LIFECYCLE
'============================================================

Private Sub UserForm_Initialize()

    Me.Caption = UI_APP_CAPTION
    Me.BackColor = UIColor_FormBackground()

    Me.Width = FORM_WIDTH
    Me.Height = FORM_HEIGHT
    Me.StartUpPosition = 1

    BuildSimilarIncidentInterface

End Sub


Private Sub UserForm_Activate()

    If mResultsList.ListCount > 0 Then
        mResultsList.SetFocus
    End If

End Sub


'============================================================
' CONTROL EVENTS
'============================================================

Private Sub mResultsList_Change()

    If mLoadingResults Then
        Exit Sub
    End If

    UpdateSelectedIncidentPreview

End Sub


Private Sub mRefreshButton_Click()

    Dim sourceCell As Range
    Dim failureReason As String

    If Not TryResolveSimilarIncidentSource( _
            ActiveCell, _
            sourceCell, _
            failureReason) Then

        MsgBox _
            failureReason, _
            vbInformation, _
            "Similar Incidents"

        Exit Sub

    End If

    LoadForSelection sourceCell

End Sub


Private Sub mOpenButton_Click()

    Dim selectedMatch As clsIncidentMatch

    Set selectedMatch = SelectedIncidentMatch()

    If selectedMatch Is Nothing Then
        Exit Sub
    End If

    OpenSimilarIncidentRow selectedMatch.worksheetRow

End Sub


Private Sub mCloseButton_Click()

    Unload Me

End Sub


