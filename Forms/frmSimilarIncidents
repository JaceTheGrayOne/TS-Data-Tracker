    Set headerLabel = _
        CreateSimilarIncidentLabel( _
            "lblSimilarRowHeader", _
            "ROW", _
            headerLeft, _
            CONTENT_TOP, _
            RESULT_ROW_COLUMN_WIDTH, _
            RESULT_HEADER_HEIGHT)

    StyleSimilarIncidentColumnHeader headerLabel

    headerLeft = _
        headerLeft + _
        RESULT_ROW_COLUMN_WIDTH

    Set headerLabel = _
        CreateSimilarIncidentLabel( _
            "lblSimilarUUTHeader", _
            "UUT", _
            headerLeft, _
            CONTENT_TOP, _
            RESULT_UUT_COLUMN_WIDTH, _
            RESULT_HEADER_HEIGHT)

    StyleSimilarIncidentColumnHeader headerLabel

    headerLeft = _
        headerLeft + _
        RESULT_UUT_COLUMN_WIDTH

    Set headerLabel = _
        CreateSimilarIncidentLabel( _
            "lblSimilarTestHeader", _
            "TEST", _
            headerLeft, _
            CONTENT_TOP, _
            RESULT_TEST_COLUMN_WIDTH, _
            RESULT_HEADER_HEIGHT)

    StyleSimilarIncidentColumnHeader headerLabel

    headerLeft = _
        headerLeft + _
        RESULT_TEST_COLUMN_WIDTH

    Set headerLabel = _
        CreateSimilarIncidentLabel( _
            "lblSimilarSummaryHeader", _
            "FAULT / PATH", _
            headerLeft, _
            CONTENT_TOP, _
            RESULT_SUMMARY_COLUMN_WIDTH, _
            RESULT_HEADER_HEIGHT)

    StyleSimilarIncidentColumnHeader headerLabel

    Set mResultsList = _
        Me.Controls.Add( _
            "Forms.ListBox.1", _
            "lstSimilarResults", _
            True)

    With mResultsList
        .Left = FORM_MARGIN
        .Top = _
            CONTENT_TOP + _
            RESULT_HEADER_HEIGHT + _
            RESULT_HEADER_GAP

        .Width = RESULT_LIST_WIDTH
        .Height = _
            CONTENT_HEIGHT - _
            RESULT_HEADER_HEIGHT - _
