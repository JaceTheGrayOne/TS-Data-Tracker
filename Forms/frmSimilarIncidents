        Me.InsideWidth - _
        FORM_MARGIN - _
        BUTTON_WIDTH

    openLeft = _
        closeLeft - _
        BUTTON_GAP - _
        BUTTON_WIDTH

    refreshLeft = _
        openLeft - _
        BUTTON_GAP - _
        BUTTON_WIDTH

