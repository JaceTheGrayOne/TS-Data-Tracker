Option Explicit


'============================================================
' CONTROL REFERENCES
'============================================================

Public WithEvents itemLabel As MSForms.Label
Public WithEvents accentLabel As MSForms.Label


'============================================================
' MODULE STATE
'============================================================

Private mValue As String
Private mKey As String
Private mPicker As frmPicker
Private mIsBranch As Boolean
Private mUseMultipleSelectionAppearance As Boolean

Private mNormalBackColor As Long
Private mNormalBorderColor As Long
Private mNormalBold As Boolean

Private mIsSelected As Boolean
Private mIsHovered As Boolean


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub Initialize( _
    ByVal itemControl As MSForms.Label, _
    ByVal accentControl As MSForms.Label, _
    ByVal itemValue As String, _
    ByVal itemKey As String, _
    ByVal isBranch As Boolean, _
    ByVal useMultipleSelectionAppearance As Boolean, _
    ByVal picker As frmPicker _
)

    Set itemLabel = itemControl
    Set accentLabel = accentControl
    Set mPicker = picker

    mValue = itemValue
    mKey = itemKey
    mIsBranch = isBranch
    mUseMultipleSelectionAppearance = useMultipleSelectionAppearance

    ' The themed card is the baseline restored after hover and selection changes.
    mNormalBackColor = itemLabel.BackColor
    mNormalBorderColor = itemLabel.BorderColor
    mNormalBold = itemLabel.Font.Bold

    ApplyAppearance

End Sub


Public Property Get itemValue() As String

    itemValue = mValue

End Property


Public Property Get itemKey() As String

    itemKey = mKey

End Property


Public Property Get isBranch() As Boolean

    isBranch = mIsBranch

End Property


Public Sub SetSelected(ByVal selected As Boolean)

    mIsSelected = selected

    ApplyAppearance

End Sub


Public Sub SetHovered(ByVal hovered As Boolean)

    mIsHovered = hovered

    ApplyAppearance

End Sub


Public Sub Cleanup()

    Set itemLabel = Nothing
    Set accentLabel = Nothing
    Set mPicker = Nothing

End Sub


'============================================================
' APPEARANCE
'============================================================

Private Sub ApplyAppearance()

    RestoreNormalAppearance

    If mIsHovered Then

        itemLabel.BackColor = UILightenColor(mNormalBackColor, UI_HOVER_LIGHTEN)
        itemLabel.Font.Bold = True

    End If

    If mIsSelected Then

        If mUseMultipleSelectionAppearance Then

            itemLabel.BorderColor = UIColor_SelectionBorder()
            accentLabel.BackColor = UIColor_SelectionBorder()

        Else

            itemLabel.BorderColor = UIDarkenColor(mNormalBackColor, UI_ACCENT_DARKEN)
            itemLabel.Font.Bold = True
            accentLabel.BackColor = UIDarkenColor(mNormalBackColor, UI_ACCENT_DARKEN)

        End If

        accentLabel.Visible = True

    ElseIf mIsHovered Then

        itemLabel.BorderColor = UIDarkenColor(mNormalBackColor, UI_ACCENT_DARKEN)
        accentLabel.BackColor = UIDarkenColor(mNormalBackColor, UI_ACCENT_DARKEN)
        accentLabel.Visible = True

    End If

End Sub


Private Sub RestoreNormalAppearance()

    itemLabel.Caption = "   " & mValue
    itemLabel.BackColor = mNormalBackColor
    itemLabel.BorderColor = mNormalBorderColor
    itemLabel.Font.Bold = mNormalBold

    accentLabel.Visible = False

End Sub


'============================================================
' CONTROL EVENTS
'============================================================

Private Sub ItemLabel_Click()

    mPicker.HandleItemClick Me

End Sub


Private Sub ItemLabel_MouseMove( _
    ByVal button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single _
)

    mPicker.HoverItem Me

End Sub


Private Sub AccentLabel_Click()

    mPicker.HandleItemClick Me

End Sub


Private Sub AccentLabel_MouseMove( _
    ByVal button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single _
)

    mPicker.HoverItem Me

End Sub

