Option Explicit


'============================================================
' MODULE STATE
'============================================================

Private mTest As String
Private mNodeID As String
Private mParentID As String
Private mLabel As String
Private mDepth As Long
Private mSortOrder As Long


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub Initialize( _
    ByVal testName As String, _
    ByVal nodeID As String, _
    ByVal ParentID As String, _
    ByVal labelText As String, _
    ByVal depthValue As Long, _
    ByVal sortValue As Long _
)

    mTest = testName
    mNodeID = nodeID
    mParentID = ParentID
    mLabel = labelText
    mDepth = depthValue
    mSortOrder = sortValue

End Sub


Public Property Get Test() As String

    Test = mTest

End Property


Public Property Get nodeID() As String

    nodeID = mNodeID

End Property


Public Property Get ParentID() As String

    ParentID = mParentID

End Property


Public Property Get Label() As String

    Label = mLabel

End Property


Public Property Get Depth() As Long

    Depth = mDepth

End Property


Public Property Get SortOrder() As Long

    SortOrder = mSortOrder

End Property

