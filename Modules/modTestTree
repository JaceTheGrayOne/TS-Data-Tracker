Option Explicit


'============================================================
' CONFIGURATION
'============================================================

Private Const TEST_HIERARCHY_TABLE As String = "tbl_TestHierarchy"


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Function GetRootNodes(ByVal testName As String) As Collection

    Dim result As Collection

    Dim tbl As ListObject
    Dim rw As listRow

    Dim colTest As Long
    Dim colParentID As Long

    Dim node As clsTestNode

    Set result = New Collection

    Set tbl = FindTestHierarchyTable()

    If tbl Is Nothing Then

        Err.Raise _
            vbObjectError + 1700, _
            "modTestTree.GetRootNodes", _
            "Could not find table '" & TEST_HIERARCHY_TABLE & "'."

    End If

    colTest = tbl.ListColumns("Test").Index
    colParentID = tbl.ListColumns("Parent ID").Index

    For Each rw In tbl.ListRows

        If StrComp( _
                Trim$(CStr(rw.Range.Cells(1, colTest).value2)), _
                Trim$(testName), _
                vbTextCompare) = 0 _
            And Len(Trim$(CStr(rw.Range.Cells(1, colParentID).value2))) = 0 Then

            Set node = BuildNodeFromHierarchyRow(rw, tbl)

            result.Add node

        End If

    Next rw

    Set GetRootNodes = result

End Function


Public Function GetChildNodes(ByVal parentNodeID As String) As Collection

    Dim result As Collection

    Dim tbl As ListObject
    Dim rw As listRow

    Dim colParentID As Long

    Dim node As clsTestNode

    Set result = New Collection

    Set tbl = FindTestHierarchyTable()

    If tbl Is Nothing Then

        Err.Raise _
            vbObjectError + 1701, _
            "modTestTree.GetChildNodes", _
            "Could not find table '" & TEST_HIERARCHY_TABLE & "'."

    End If

    ' Edge Case Defense:
    ' Blank Node ID must not resolve root nodes as children.
    If Len(Trim$(parentNodeID)) = 0 Then

        Set GetChildNodes = result

        Exit Function

    End If

    colParentID = tbl.ListColumns("Parent ID").Index

    For Each rw In tbl.ListRows

        If StrComp( _
                Trim$(CStr(rw.Range.Cells(1, colParentID).value2)), _
                Trim$(parentNodeID), _
                vbTextCompare) = 0 Then

            Set node = BuildNodeFromHierarchyRow(rw, tbl)

            result.Add node

        End If

    Next rw

    Set GetChildNodes = result

End Function


Public Function HasChildNodes(ByVal nodeID As String) As Boolean

    Dim tbl As ListObject
    Dim rw As listRow

    Dim colParentID As Long

    Set tbl = FindTestHierarchyTable()

    If tbl Is Nothing Then

        Err.Raise _
            vbObjectError + 1702, _
            "modTestTree.HasChildNodes", _
            "Could not find table '" & TEST_HIERARCHY_TABLE & "'."

    End If

    ' Edge Case Defense:
    ' Blank Node ID must not match root-node Parent IDs.
    If Len(Trim$(nodeID)) = 0 Then Exit Function

    colParentID = tbl.ListColumns("Parent ID").Index

    For Each rw In tbl.ListRows

        If StrComp( _
                Trim$(CStr(rw.Range.Cells(1, colParentID).value2)), _
                Trim$(nodeID), _
                vbTextCompare) = 0 Then

            HasChildNodes = True

            Exit Function

        End If

    Next rw

End Function


Public Function GetNodeByID(ByVal nodeID As String) As clsTestNode

    Dim tbl As ListObject
    Dim rw As listRow

    Dim colNodeID As Long

    Set tbl = FindTestHierarchyTable()

    If tbl Is Nothing Then

        Err.Raise _
            vbObjectError + 1703, _
            "modTestTree.GetNodeByID", _
            "Could not find table '" & TEST_HIERARCHY_TABLE & "'."

    End If

    If Len(Trim$(nodeID)) = 0 Then Exit Function

    colNodeID = tbl.ListColumns("Node ID").Index

    For Each rw In tbl.ListRows

        If StrComp( _
                Trim$(CStr(rw.Range.Cells(1, colNodeID).value2)), _
                Trim$(nodeID), _
                vbTextCompare) = 0 Then

            Set GetNodeByID = BuildNodeFromHierarchyRow(rw, tbl)

            Exit Function

        End If

    Next rw

End Function


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function BuildNodeFromHierarchyRow( _
    ByVal rw As listRow, _
    ByVal tbl As ListObject _
) As clsTestNode

    Dim node As clsTestNode

    Set node = New clsTestNode

    node.Initialize _
        CStr(rw.Range.Cells(1, tbl.ListColumns("Test").Index).value2), _
        CStr(rw.Range.Cells(1, tbl.ListColumns("Node ID").Index).value2), _
        CStr(rw.Range.Cells(1, tbl.ListColumns("Parent ID").Index).value2), _
        CStr(rw.Range.Cells(1, tbl.ListColumns("Label").Index).value2), _
        CLng(rw.Range.Cells(1, tbl.ListColumns("Depth").Index).value2), _
        CLng(rw.Range.Cells(1, tbl.ListColumns("Sort Order").Index).value2)

    Set BuildNodeFromHierarchyRow = node

End Function


Private Function FindTestHierarchyTable() As ListObject

    Dim ws As Worksheet
    Dim tbl As ListObject

    For Each ws In ThisWorkbook.Worksheets

        Set tbl = Nothing

        On Error Resume Next

        Set tbl = ws.ListObjects(TEST_HIERARCHY_TABLE)

        On Error GoTo 0

        If Not tbl Is Nothing Then

            Set FindTestHierarchyTable = tbl

            Exit Function

        End If

    Next ws

End Function


'============================================================
' TEST HARNESS
'============================================================

Public Sub TestTreeEngine()

    Dim nodes As Collection
    Dim node As clsTestNode

    Debug.Print String(70, "=")
    Debug.Print "TEST TREE ENGINE"
    Debug.Print String(70, "=")

    Set nodes = GetRootNodes("Functional (Red)")

    If nodes.Count > 0 Then

        Set node = nodes(1)

        If node.nodeID = "TN-000001" _
            And node.Label = "7.2 - Test Setup" Then

            Debug.Print _
                "PASS  First Functional (Red) root = " & _
                node.nodeID & " [" & node.Label & "]"

        Else

            Debug.Print "FAIL  Unexpected first Functional (Red) root."

        End If

    Else

        Debug.Print "FAIL  Functional (Red) returned no root nodes."

    End If

    Set nodes = GetChildNodes("TN-000001")

    If nodes.Count = 2 Then

        Debug.Print "PASS  TN-000001 has 2 direct children."

    Else

        Debug.Print "FAIL  TN-000001 expected 2 children; got " & nodes.Count

    End If

    If nodes.Count >= 2 Then

        If nodes(1).nodeID = "TN-000002" _
            And nodes(1).Label = "7.3 - Enable PDU" _
            And nodes(2).nodeID = "TN-000007" _
            And nodes(2).Label = "7.6 - Warm Start" Then

            Debug.Print "PASS  TN-000001 child identities correct."

        Else

            Debug.Print "FAIL  TN-000001 child identities incorrect."

        End If

    End If

    Set nodes = GetChildNodes("TN-000002")

    If nodes.Count = 4 Then

        Debug.Print "PASS  TN-000002 has 4 direct children."

    Else

        Debug.Print "FAIL  TN-000002 expected 4 children; got " & nodes.Count

    End If

    If Not HasChildNodes("TN-000003") Then

        Debug.Print "PASS  TN-000003 is a leaf."

    Else

        Debug.Print "FAIL  TN-000003 unexpectedly has children."

    End If

    If HasChildNodes("TN-000015") Then

        Debug.Print "PASS  TN-000015 has children."

    Else

        Debug.Print "FAIL  TN-000015 should have children."

    End If

    Set nodes = GetRootNodes("Functional (Black)")

    If nodes.Count > 0 Then

        Set node = nodes(1)

        If node.Label = "Check Engineering Flags" Then

            Debug.Print _
                "PASS  First Functional (Black) root = " & _
                node.nodeID & " [" & node.Label & "]"

        Else

            Debug.Print "FAIL  Unexpected first Functional (Black) root."

        End If

    Else

        Debug.Print "FAIL  Functional (Black) returned no root nodes."

    End If

    Debug.Print String(70, "=")

End Sub

