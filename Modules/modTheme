Option Explicit


'============================================================
' CONFIGURATION
'============================================================

Private Const THEME_TABLE_NAME As String = "tbl_Theme"
Private Const EXACT_MATCH_SCORE_BASE As Long = 100000


'============================================================
' THEME LOOKUP
'============================================================

Public Function TryGetTheme( _
    ByVal fieldName As String, _
    ByVal itemValue As String, _
    ByRef fillColor As Long, _
    ByRef textColor As Long, _
    ByRef isBold As Boolean _
) As Boolean

    Dim themeTable As ListObject
    Dim themeRow As listRow
    Dim fieldColumn As Long
    Dim matchTypeColumn As Long
    Dim valueColumn As Long
    Dim fillColumn As Long
    Dim textColumn As Long
    Dim boldColumn As Long
    Dim ruleField As String
    Dim matchType As String
    Dim ruleValue As String
    Dim fillHex As String
    Dim textHex As String
    Dim isMatch As Boolean
    Dim matchScore As Long
    Dim bestScore As Long

    ' Edge Case Defense:
    ' ByRef outputs are reset so a failed lookup cannot return stale theme data.
    fillColor = 0
    textColor = 0
    isBold = False

    Set themeTable = FindThemeTable()

    If themeTable Is Nothing Then

        Err.Raise _
            vbObjectError + 1300, _
            "modTheme.TryGetTheme", _
            "Could not find table '" & THEME_TABLE_NAME & "'."

    End If

    If themeTable.DataBodyRange Is Nothing Then Exit Function

    fieldColumn = themeTable.ListColumns("Field").Index
    matchTypeColumn = themeTable.ListColumns("Match Type").Index
    valueColumn = themeTable.ListColumns("Value").Index
    fillColumn = themeTable.ListColumns("Fill Hex").Index
    textColumn = themeTable.ListColumns("Text Hex").Index
    boldColumn = themeTable.ListColumns("Bold").Index

    bestScore = -1

    For Each themeRow In themeTable.ListRows

        ruleField = Trim$(CStr(themeRow.Range.Cells(1, fieldColumn).value2))
        matchType = Trim$(CStr(themeRow.Range.Cells(1, matchTypeColumn).value2))
        ruleValue = Trim$(CStr(themeRow.Range.Cells(1, valueColumn).value2))

        If StrComp(ruleField, fieldName, vbTextCompare) = 0 Then

            isMatch = False
            matchScore = -1

            Select Case LCase$(matchType)

                Case "exact"

                    If StrComp(itemValue, ruleValue, vbTextCompare) = 0 Then
                        isMatch = True
                        matchScore = EXACT_MATCH_SCORE_BASE + Len(ruleValue)
                    End If

                Case "starts with"

                    If Len(ruleValue) > 0 Then

                        If StrComp( _
                                Left$(itemValue, Len(ruleValue)), _
                                ruleValue, _
                                vbTextCompare) = 0 Then

                            isMatch = True
                            matchScore = Len(ruleValue)

                        End If

                    End If

                Case Else

                    Err.Raise _
                        vbObjectError + 1302, _
                        "modTheme.TryGetTheme", _
                        "Unknown Match Type '" & matchType & "'."

            End Select

            If isMatch And matchScore > bestScore Then

                bestScore = matchScore

                fillHex = Trim$(CStr(themeRow.Range.Cells(1, fillColumn).value2))
                textHex = Trim$(CStr(themeRow.Range.Cells(1, textColumn).value2))

                fillColor = HexToVBAColor(fillHex)
                textColor = HexToVBAColor(textHex)
                isBold = CBool(themeRow.Range.Cells(1, boldColumn).value)

                TryGetTheme = True

            End If

        End If

    Next themeRow

End Function


'============================================================
' THEME APPLICATION
'============================================================

Public Sub ApplyThemeToCell(ByVal targetCell As Range, ByVal fieldName As String)

    Dim cellValue As Variant
    Dim itemValues As String
    Dim fillColor As Long
    Dim textColor As Long
    Dim isBold As Boolean

    ResetCellTheme targetCell

    cellValue = targetCell.value2

    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Sub

    itemValues = Trim$(CStr(cellValue))

    If Len(itemValues) = 0 Then Exit Sub

    If TryGetCombinedTheme(fieldName, itemValues, fillColor, textColor, isBold) Then

        targetCell.Interior.Pattern = xlSolid
        targetCell.Interior.Color = fillColor
        targetCell.Font.Color = textColor
        targetCell.Font.Bold = isBold

    End If

End Sub


Public Sub ResetCellTheme(ByVal targetCell As Range)

    targetCell.Interior.Pattern = xlNone
    targetCell.Font.Color = UIColor_ItemText()
    targetCell.Font.Bold = False

End Sub


Private Function TryGetCombinedTheme( _
    ByVal fieldName As String, _
    ByVal itemValues As String, _
    ByRef fillColor As Long, _
    ByRef textColor As Long, _
    ByRef isBold As Boolean _
) As Boolean

    Dim values As Collection
    Dim item As Variant
    Dim itemFillColor As Long
    Dim itemTextColor As Long
    Dim itemIsBold As Boolean
    Dim firstTheme As Boolean

    Set values = GetHierarchySelectionLines(itemValues)

    If values.Count = 0 Then Exit Function

    For Each item In values

        If Not TryGetTheme( _
                fieldName, _
                CStr(item), _
                itemFillColor, _
                itemTextColor, _
                itemIsBold) Then Exit Function

        If Not firstTheme Then

            fillColor = itemFillColor
            textColor = itemTextColor
            isBold = itemIsBold
            firstTheme = True

        ElseIf itemFillColor <> fillColor _
            Or itemTextColor <> textColor _
            Or itemIsBold <> isBold Then

            Exit Function

        End If

    Next item

    TryGetCombinedTheme = firstTheme

End Function


'============================================================
' COLOR UTILITIES
'============================================================

Public Function HexToVBAColor(ByVal hexColor As String) As Long

    Dim cleaned As String
    Dim redValue As Long
    Dim greenValue As Long
    Dim blueValue As Long

    cleaned = Replace$(Trim$(hexColor), "#", "")

    If Len(cleaned) <> 6 Then

        Err.Raise _
            vbObjectError + 1301, _
            "modTheme.HexToVBAColor", _
            "Invalid color '" & hexColor & "'. Expected #RRGGBB."

    End If

    redValue = CLng("&H" & Mid$(cleaned, 1, 2))
    greenValue = CLng("&H" & Mid$(cleaned, 3, 2))
    blueValue = CLng("&H" & Mid$(cleaned, 5, 2))

    HexToVBAColor = RGB(redValue, greenValue, blueValue)

End Function


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function FindThemeTable() As ListObject

    Dim ws As Worksheet
    Dim themeTable As ListObject

    For Each ws In ThisWorkbook.Worksheets

        Set themeTable = Nothing

        On Error Resume Next
        Set themeTable = ws.ListObjects(THEME_TABLE_NAME)
        On Error GoTo 0

        If Not themeTable Is Nothing Then
            Set FindThemeTable = themeTable
            Exit Function
        End If

    Next ws

End Function


'============================================================
' TEST HARNESS
'============================================================

Public Sub TestThemeEngine()

    Dim fillColor As Long
    Dim textColor As Long
    Dim isBold As Boolean

    Debug.Print String$(70, "=")
    Debug.Print "THEME ENGINE TEST"
    Debug.Print String$(70, "=")

    If TryGetTheme("Sub Step 1", "Cold 1", fillColor, textColor, isBold) Then

        Debug.Print "PASS  Theme found for Sub Step 1 = Cold 1"
        Debug.Print "      Fill: " & fillColor
        Debug.Print "      Text: " & textColor
        Debug.Print "      Bold: " & isBold

    Else

        Debug.Print "FAIL  No theme found for Sub Step 1 = Cold 1"

    End If

    Debug.Print String$(70, "=")

End Sub

