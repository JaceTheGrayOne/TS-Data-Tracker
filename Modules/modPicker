Option Explicit


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub OpenPickerForCell(ByVal targetCell As Range)

    Dim values As Collection
    Dim fieldName As String
    Dim contextText As String
    Dim targetIDColumn As Long
    Dim allowMultipleSelection As Boolean

    If Not TryResolvePickerRequest( _
            targetCell, _
            values, _
            fieldName, _
            contextText, _
            targetIDColumn, _
            allowMultipleSelection) Then Exit Sub

    frmPicker.LoadPicker _
        targetCell, _
        fieldName, _
        values, _
        contextText, _
        targetIDColumn, _
        allowMultipleSelection

    PositionPickerNearCell frmPicker, targetCell

    frmPicker.Show vbModeless

End Sub


Public Function ShowGuidedPickerForCell(ByVal targetCell As Range) As Boolean

    Dim picker As frmPicker
    Dim values As Collection
    Dim fieldName As String
    Dim contextText As String
    Dim targetIDColumn As Long
    Dim allowMultipleSelection As Boolean
    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    On Error GoTo ShowFailed

    If Not TryResolvePickerRequest( _
            targetCell, _
            values, _
            fieldName, _
            contextText, _
            targetIDColumn, _
            allowMultipleSelection) Then Exit Function

    Set picker = New frmPicker

    picker.LoadPicker _
        targetCell, _
        fieldName, _
        values, _
        contextText, _
        targetIDColumn, _
        allowMultipleSelection, _
        True

    PositionPickerNearCell picker, targetCell

    picker.Show vbModal

    ShowGuidedPickerForCell = picker.SelectionConfirmed

    Unload picker

    Exit Function


ShowFailed:

    savedErrNumber = Err.Number
    savedErrDescription = Err.description

    On Error Resume Next

    If Not picker Is Nothing Then
        Unload picker
    End If

    On Error GoTo 0

    Err.Raise _
        savedErrNumber, _
        "modPicker.ShowGuidedPickerForCell", _
        savedErrDescription

End Function


'============================================================
' PICKER REQUEST RESOLUTION
'============================================================

Private Function TryResolvePickerRequest( _
    ByVal targetCell As Range, _
    ByRef values As Collection, _
    ByRef fieldName As String, _
    ByRef contextText As String, _
    ByRef targetIDColumn As Long, _
    ByRef allowMultipleSelection As Boolean _
) As Boolean

    Dim roots As Collection
    Dim parentField As String
    Dim failureType As String
    Dim parentValue As String
    Dim parentNodeIDs As String
    Dim branchValue As String
    Dim branchNodeID As String
    Dim testName As String
    Dim failureValue As Variant
    Dim parentIDColumn As Long
    Dim branchCount As Long
    Dim uutColumn As Long
    Dim failureTypeColumn As Long
    Dim testColumn As Long
    Dim testStepColumn As Long
    Dim subStep4Column As Long

    If targetCell Is Nothing Then Exit Function

    Set values = Nothing

    fieldName = vbNullString
    contextText = vbNullString
    targetIDColumn = 0
    allowMultipleSelection = False

    uutColumn = fieldColumn("UUT")
    failureTypeColumn = fieldColumn("Failure Type")
    testColumn = fieldColumn("Test")
    testStepColumn = fieldColumn("Test Step")
    subStep4Column = fieldColumn("Sub Step 4")

    If targetCell.Column >= testColumn And targetCell.Column <= subStep4Column Then

        failureValue = targetCell.Worksheet.Cells(targetCell.Row, failureTypeColumn).value2

        If IsError(failureValue) Then Exit Function

        If Not IsEmpty(failureValue) Then
            failureType = Trim$(CStr(failureValue))
        End If

        If FailureTypeSuppressesTestHierarchy(failureType) Then Exit Function

    End If

    Select Case targetCell.Column

        Case uutColumn

            fieldName = "UUT"
            Set values = GetCatalogValues("lst_UUT", "UUT")

        Case failureTypeColumn

            fieldName = "Failure Type"
            Set values = GetCatalogValues("lst_FailureType", "Failure Type")

        Case testColumn

            fieldName = "Test"
            Set values = GetCatalogValues("lst_Test", "Test")

        Case testStepColumn

            fieldName = "Test Step"
            testName = PickerCellText(targetCell.Worksheet.Cells(targetCell.Row, testColumn))

            If Len(testName) = 0 Or testName = "-" Then Exit Function

            Set roots = GetRootNodes(testName)

            If roots.Count > 0 Then

                Set values = roots
                targetIDColumn = NodeIDColumn(fieldName)

            Else

                Set values = GetRoutedValues("Test", testName, fieldName)

            End If

            contextText = BuildPickerContext(targetCell)
            allowMultipleSelection = True

        Case testStepColumn + 1 To subStep4Column

            fieldName = FieldNameFromColumn(targetCell.Column)
            parentField = FieldNameFromColumn(targetCell.Column - 1)

            If Len(fieldName) = 0 Or Len(parentField) = 0 Then Exit Function

            parentValue = PickerCellText(targetCell.Worksheet.Cells(targetCell.Row, targetCell.Column - 1))

            If Len(parentValue) = 0 Or parentValue = "-" Then Exit Function

            parentIDColumn = NodeIDColumn(parentField)

            If parentIDColumn > 0 Then
                parentNodeIDs = PickerCellText(targetCell.Worksheet.Cells(targetCell.Row, parentIDColumn))
            End If

            If Not TryGetHierarchyBranchSelection( _
                    parentField, _
                    parentValue, _
                    parentNodeIDs, _
                    branchValue, _
                    branchNodeID, _
                    branchCount) Then Exit Function

            If branchCount <> 1 Then Exit Function

            If Len(branchNodeID) > 0 Then

                Set values = GetChildNodes(branchNodeID)
                targetIDColumn = NodeIDColumn(fieldName)

            Else

                Set values = GetRoutedValues(parentField, branchValue, fieldName)

            End If

            contextText = BuildPickerContext(targetCell)
            allowMultipleSelection = True

        Case Else
            Exit Function

    End Select

    If values Is Nothing Then Exit Function
    If values.Count = 0 Then Exit Function

    TryResolvePickerRequest = True

End Function


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function BuildPickerContext(ByVal targetCell As Range) As String

    Dim columnNumber As Long
    Dim valueText As String
    Dim displayText As String
    Dim result As String

    For columnNumber = fieldColumn("Test") To targetCell.Column - 1

        valueText = PickerCellText(targetCell.Worksheet.Cells(targetCell.Row, columnNumber))

        If Len(valueText) > 0 And valueText <> "-" Then

            displayText = FormatHierarchySelectionForDisplay(valueText)

            If Len(result) > 0 Then
                result = result & "  >  "
            End If

            result = result & displayText

        End If

    Next columnNumber

    BuildPickerContext = result

End Function


Private Function PickerCellText(ByVal sourceCell As Range) As String

    Dim cellValue As Variant

    cellValue = sourceCell.value2

    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function

    PickerCellText = Trim$(CStr(cellValue))

End Function

