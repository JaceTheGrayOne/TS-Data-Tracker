Option Explicit


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Function GetCatalogRange( _
    ByVal tableName As String, _
    ByVal columnName As String _
) As Range

    Dim tbl As ListObject
    Dim col As listColumn

    Set tbl = FindCatalogTable(tableName)

    If tbl Is Nothing Then

        Err.Raise _
            vbObjectError + 1200, _
            "modCatalog.GetCatalogRange", _
            "Could not find table '" & tableName & "'."

    End If

    On Error Resume Next

    Set col = tbl.ListColumns(columnName)

    On Error GoTo 0

    If col Is Nothing Then

        Err.Raise _
            vbObjectError + 1201, _
            "modCatalog.GetCatalogRange", _
            "Table '" & tableName & _
            "' does not contain column '" & columnName & "'."

    End If

    If col.DataBodyRange Is Nothing Then

        Err.Raise _
            vbObjectError + 1202, _
            "modCatalog.GetCatalogRange", _
            "Catalog '" & tableName & _
            "[" & columnName & "]' contains no data rows."

    End If

    Set GetCatalogRange = col.DataBodyRange

End Function


Public Function GetCatalogValues( _
    ByVal tableName As String, _
    ByVal columnName As String _
) As Collection

    Dim result As Collection
    Dim sourceRange As Range
    Dim cell As Range
    Dim valueText As String

    Set result = New Collection
    Set sourceRange = GetCatalogRange(tableName, columnName)

    For Each cell In sourceRange.Cells

        If Not IsError(cell.value2) Then

            valueText = Trim$(CStr(cell.value2))

            If Len(valueText) > 0 Then
                result.Add valueText
            End If

        End If

    Next cell

    Set GetCatalogValues = result

End Function


Public Function GetRoutedValues( _
    ByVal parentField As String, _
    ByVal parentValue As String, _
    ByVal childField As String _
) As Collection

    Dim tableName As String
    Dim columnName As String
    Dim result As Collection

    If Not TryGetRoute( _
            parentField, _
            parentValue, _
            childField, _
            tableName, _
            columnName) Then

        ' No configured route is represented by Nothing.
        Set GetRoutedValues = Nothing

        Exit Function

    End If

    Set result = GetCatalogValues(tableName, columnName)
    Set GetRoutedValues = result

End Function


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function FindCatalogTable(ByVal tableName As String) As ListObject

    Dim ws As Worksheet
    Dim tbl As ListObject

    For Each ws In ThisWorkbook.Worksheets

        Set tbl = Nothing

        On Error Resume Next

        Set tbl = ws.ListObjects(tableName)

        On Error GoTo 0

        If Not tbl Is Nothing Then

            Set FindCatalogTable = tbl

            Exit Function

        End If

    Next ws

End Function


'============================================================
' TEST HARNESS
'============================================================

Public Sub TestCatalogEngine()

    Debug.Print String(70, "=")
    Debug.Print "CATALOG ENGINE TEST"
    Debug.Print String(70, "=")

    TestRoutedCatalog "Test", "Thermal", "Test Step", "ESS Op Cycle"
    TestRoutedCatalog "Test Step", "ESS Op Cycle", "Sub Step 1", "Cold 1"
    TestRoutedCatalog "Sub Step 1", "Cold 1", "Sub Step 2", "EIA530 Baseband Red"

    TestMissingCatalogRoute "Test Step", "7.2 Test Setup", "Sub Step 1"

    Debug.Print String(70, "=")

End Sub


Private Sub TestRoutedCatalog( _
    ByVal parentField As String, _
    ByVal parentValue As String, _
    ByVal childField As String, _
    ByVal expectedValue As String _
)

    Dim values As Collection
    Dim item As Variant
    Dim found As Boolean

    Set values = GetRoutedValues(parentField, parentValue, childField)

    If values Is Nothing Then

        Debug.Print "FAIL  " & parentField & " = " & parentValue & " -> NO CATALOG"

        Exit Sub

    End If

    For Each item In values

        If StrComp(CStr(item), expectedValue, vbTextCompare) = 0 Then

            found = True

            Exit For

        End If

    Next item

    If found Then

        Debug.Print _
            "PASS  " & parentField & " = " & parentValue & _
            " -> " & values.Count & _
            " item(s); contains [" & expectedValue & "]"

    Else

        Debug.Print "FAIL  " & parentField & " = " & parentValue
        Debug.Print "      Expected catalog to contain: [" & expectedValue & "]"
        Debug.Print "      Actual values:"

        For Each item In values
            Debug.Print "          " & CStr(item)
        Next item

    End If

End Sub


Private Sub TestMissingCatalogRoute( _
    ByVal parentField As String, _
    ByVal parentValue As String, _
    ByVal childField As String _
)

    Dim values As Collection

    Set values = GetRoutedValues(parentField, parentValue, childField)

    If values Is Nothing Then

        Debug.Print "PASS  No catalog route: " & parentField & " = " & parentValue

    Else

        Debug.Print "FAIL  Expected no catalog route for " & parentField & " = " & parentValue

    End If

End Sub
