Option Explicit


'============================================================
' WINDOWS API
'============================================================

#If VBA7 Then

    Private Declare PtrSafe Function GetDpiForWindow _
        Lib "user32" ( _
        ByVal hWnd As LongPtr _
    ) As Long

#Else

    Private Declare Function GetDpiForWindow _
        Lib "user32" ( _
        ByVal hWnd As Long _
    ) As Long

#End If


'============================================================
' CONFIGURATION
'============================================================

Private Const POINTS_PER_INCH As Double = 72#
Private Const DEFAULT_DPI As Long = 96

Private Const PICKER_GAP_PIXELS As Long = 8
Private Const WINDOW_MARGIN_POINTS As Double = 8#


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub PositionPickerNearCell( _
    ByVal picker As Object, _
    ByVal targetCell As Range _
)

    Dim win As Window

    Dim dpi As Long

    Dim cellLeftPixels As Long
    Dim cellRightPixels As Long
    Dim cellTopPixels As Long

    Dim cellLeftPoints As Double
    Dim cellRightPoints As Double
    Dim cellTopPoints As Double

    Dim gapPoints As Double

    Dim pickerLeft As Double
    Dim pickerTop As Double

    Dim excelLeft As Double
    Dim excelTop As Double
    Dim excelRight As Double
    Dim excelBottom As Double

    Set win = ActiveWindow

    If win Is Nothing Then Exit Sub

    dpi = GetDpiForWindow(Application.hWnd)

    ' Edge Case Defense:
    ' Fall back to standard Windows DPI if window DPI is unavailable.
    If dpi <= 0 Then
        dpi = DEFAULT_DPI
    End If

    '----------------------------------------------------
    ' SCREEN COORDINATES
    '----------------------------------------------------
    cellLeftPixels = win.PointsToScreenPixelsX(CLng(targetCell.Left))
    cellRightPixels = win.PointsToScreenPixelsX(CLng(targetCell.Left + targetCell.Width))
    cellTopPixels = win.PointsToScreenPixelsY(CLng(targetCell.Top))

    ' UserForm position is expressed in points, not screen pixels.
    cellLeftPoints = PixelsToPoints(cellLeftPixels, dpi)
    cellRightPoints = PixelsToPoints(cellRightPixels, dpi)
    cellTopPoints = PixelsToPoints(cellTopPixels, dpi)

    gapPoints = PixelsToPoints(PICKER_GAP_PIXELS, dpi)

    '----------------------------------------------------
    ' INITIAL POSITION
    '----------------------------------------------------
    pickerLeft = cellRightPoints + gapPoints
    pickerTop = cellTopPoints

    '----------------------------------------------------
    ' WINDOW CONSTRAINTS
    '----------------------------------------------------
    excelLeft = Application.Left
    excelTop = Application.Top
    excelRight = Application.Left + Application.Width
    excelBottom = Application.Top + Application.Height

    If pickerLeft + picker.Width > excelRight - WINDOW_MARGIN_POINTS Then
        pickerLeft = cellLeftPoints - picker.Width - gapPoints
    End If

    If pickerLeft < excelLeft + WINDOW_MARGIN_POINTS Then
        pickerLeft = excelLeft + WINDOW_MARGIN_POINTS
    End If

    If pickerTop + picker.Height > excelBottom - WINDOW_MARGIN_POINTS Then
        pickerTop = excelBottom - picker.Height - WINDOW_MARGIN_POINTS
    End If

    If pickerTop < excelTop + WINDOW_MARGIN_POINTS Then
        pickerTop = excelTop + WINDOW_MARGIN_POINTS
    End If

    picker.StartUpPosition = 0
    picker.Left = pickerLeft
    picker.Top = pickerTop

End Sub


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function PixelsToPoints( _
    ByVal pixels As Double, _
    ByVal dpi As Long _
) As Double

    PixelsToPoints = pixels * POINTS_PER_INCH / dpi

End Function
