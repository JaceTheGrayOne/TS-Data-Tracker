Public Sub TestIncidentSimilarityEngine()

    Dim sourceCell As Range
    Dim matches As Collection
    Dim match As clsIncidentMatch

    Dim failureReason As String
    Dim sourceSummary As String

    Dim sourceCriteriaCount As Long
    Dim recordsEvaluated As Long
    Dim matchIndex As Long

    On Error GoTo TestFailed

    If Not TryResolveSimilarIncidentSource(ActiveCell, sourceCell, failureReason) Then

        Debug.Print "FAIL  " & failureReason

        Exit Sub

    End If

    Set matches = FindSimilarIncidents( _
        sourceCell, _
        sourceSummary, _
        sourceCriteriaCount, _
        recordsEvaluated)

    Debug.Print String$(70, "=")
    Debug.Print "SIMILAR INCIDENTS ENGINE TEST"
    Debug.Print String$(70, "=")
    Debug.Print sourceSummary
    Debug.Print String$(70, "-")
    Debug.Print CStr(recordsEvaluated) & " records evaluated."

    For matchIndex = 1 To matches.Count

        Set match = matches(matchIndex)

        Debug.Print _
            Format$(matchIndex, "00") & _
            "  " & Format$(match.Score, "000") & _
            "%  Row " & CStr(match.WorksheetRow) & _
            "  " & match.MatchLevel

        Debug.Print match.reasonsText

    Next matchIndex

    Debug.Print String$(70, "=")

    Exit Sub


TestFailed:

    Debug.Print "FAIL  Error " & CStr(Err.Number) & "  " & Err.description

End Sub

