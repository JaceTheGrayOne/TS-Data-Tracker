Option Explicit


'============================================================
' CONFIGURATION
'============================================================

Private Const INCIDENT_SHEET_NAME As String = "TS Data"
Private Const INCIDENT_TABLE_NAME As String = "lst_TS_Data"

Private Const MAX_MATCH_RESULTS As Long = 25
Private Const MIN_RESULT_SCORE As Long = 25
Private Const MIN_SOURCE_CRITERIA As Long = 2

Private Const WEIGHT_UUT As Long = 18
Private Const WEIGHT_SERIAL_NUMBER As Long = 7
Private Const WEIGHT_TEST As Long = 12
Private Const WEIGHT_TEST_PATH As Long = 28
Private Const WEIGHT_FAULT_EXACT As Long = 15
Private Const WEIGHT_FAULT_TERMS As Long = 15
Private Const WEIGHT_NOTES_TERMS As Long = 5


'============================================================
' INTERNAL TYPES
'============================================================

Private Type IncidentColumnMap
    DateIndex As Long
    UUTIndex As Long
    SerialNumberIndex As Long
    TestIndex As Long
    PathStartIndex As Long
    FaultIndex As Long
    CauseIndex As Long
    ResolutionIndex As Long
    NotesIndex As Long
End Type


Private Type IncidentRecordData
    WorksheetRow As Long

    DateText As String
    UUT As String
    serialNumber As String
    testName As String

    PathValues(1 To 5) As String
    PathIDs(1 To 5) As String
    TestPath As String

    FaultText As String
    CauseText As String
    ResolutionText As String
    NotesText As String
End Type


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub ShowSimilarIncidentsForSelection()

    Dim sourceCell As Range
    Dim failureReason As String

    On Error GoTo ShowFailed

    If ActiveWorkbook Is Nothing Then

        MsgBox "No workbook is active.", vbInformation, "Similar Incidents"

        Exit Sub

    End If

    If Not TryResolveSimilarIncidentSource(ActiveCell, sourceCell, failureReason) Then

        MsgBox failureReason, vbInformation, "Similar Incidents"

        Exit Sub

    End If

    Load frmSimilarIncidents

    If Not frmSimilarIncidents.LoadForSelection(sourceCell) Then

        Unload frmSimilarIncidents

        Exit Sub

    End If

    frmSimilarIncidents.Show vbModeless

    Exit Sub


ShowFailed:

    MsgBox _
        "Similar Incidents could not be opened." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Similar Incidents"

End Sub


Public Function TryResolveSimilarIncidentSource( _
    ByVal target As Range, _
    ByRef sourceCell As Range, _
    ByRef failureReason As String _
) As Boolean

    Dim ws As Worksheet
    Dim dataTable As ListObject
    Dim sourceRange As Range
    Dim cell As Range

    Dim firstDataRow As Long
    Dim lastDataRow As Long
    Dim rowHasContent As Boolean

    Set sourceCell = Nothing
    failureReason = vbNullString

    If target Is Nothing Then

        failureReason = "Select a troubleshooting record before running Similar Incidents."

        Exit Function

    End If

    Set ws = target.Worksheet

    If Not (ws.Parent Is ThisWorkbook) Then

        failureReason = "Select a record in this troubleshooting workbook."

        Exit Function

    End If

    If StrComp(ws.Name, INCIDENT_SHEET_NAME, vbTextCompare) <> 0 Then

        failureReason = "Select a record on the TS Data worksheet."

        Exit Function

    End If

    Set dataTable = ws.ListObjects(INCIDENT_TABLE_NAME)

    firstDataRow = dataTable.HeaderRowRange.Row + 1
    lastDataRow = GetLastIncidentDataRow(dataTable)

    If target.Row < firstDataRow Or target.Row > lastDataRow Then

        failureReason = "Select a populated troubleshooting record row."

        Exit Function

    End If

    Set sourceRange = ws.Range( _
        ws.Cells(target.Row, dataTable.Range.Column), _
        ws.Cells(target.Row, dataTable.Range.Column + dataTable.ListColumns.Count - 1))

    For Each cell In sourceRange.Cells

        If Not IsError(cell.value2) Then

            If Len(Trim$(CStr(cell.value2))) > 0 Then

                rowHasContent = True

                Exit For

            End If

        End If

    Next cell

    If Not rowHasContent Then

        failureReason = "Select a populated troubleshooting record row."

        Exit Function

    End If

    Set sourceCell = ws.Cells(target.Row, dataTable.Range.Column)

    TryResolveSimilarIncidentSource = True

End Function


Public Function FindSimilarIncidents( _
    ByVal sourceCell As Range, _
    ByRef sourceSummary As String, _
    ByRef sourceCriteriaCount As Long, _
    ByRef recordsEvaluated As Long _
) As Collection

    Dim ws As Worksheet
    Dim dataTable As ListObject
    Dim dataRange As Range
    Dim idRange As Range

    Dim dataValues As Variant
    Dim idValues As Variant

    Dim columns As IncidentColumnMap
    Dim sourceRecord As IncidentRecordData
    Dim candidateRecord As IncidentRecordData

    Dim sourceFaultTerms As Collection
    Dim sourceNotesTerms As Collection
    Dim matches As Collection
    Dim candidateMatch As clsIncidentMatch

    Dim firstDataRow As Long
    Dim lastDataRow As Long
    Dim sourceIndex As Long
    Dim candidateIndex As Long
    Dim candidateWorksheetRow As Long

    Set ws = ThisWorkbook.Worksheets(INCIDENT_SHEET_NAME)
    Set dataTable = ws.ListObjects(INCIDENT_TABLE_NAME)

    LoadIncidentColumnMap dataTable, columns

    firstDataRow = dataTable.HeaderRowRange.Row + 1
    lastDataRow = GetLastIncidentDataRow(dataTable)

    If lastDataRow < firstDataRow Then

        Err.Raise _
            vbObjectError + 2100, _
            "FindSimilarIncidents", _
            "No troubleshooting records are available for comparison."

    End If

    sourceIndex = sourceCell.Row - firstDataRow + 1

    If sourceIndex < 1 Or sourceCell.Row > lastDataRow Then

        Err.Raise _
            vbObjectError + 2101, _
            "FindSimilarIncidents", _
            "The selected source row is outside the populated record set."

    End If

    Set dataRange = ws.Range( _
        ws.Cells(firstDataRow, dataTable.Range.Column), _
        ws.Cells(lastDataRow, dataTable.Range.Column + dataTable.ListColumns.Count - 1))

    Set idRange = ws.Range( _
        ws.Cells(firstDataRow, NodeIDColumn("Test Step")), _
        ws.Cells(lastDataRow, NodeIDColumn("Sub Step 4")))

    dataValues = dataRange.value2
    idValues = idRange.value2

    LoadIncidentRecord _
        sourceRecord, _
        dataValues, _
        idValues, _
        sourceIndex, _
        sourceCell.Row, _
        columns

    Set sourceFaultTerms = GetIncidentTerms(sourceRecord.FaultText)
    Set sourceNotesTerms = GetIncidentTerms(sourceRecord.NotesText)

    sourceCriteriaCount = CountSourceCriteria(sourceRecord, sourceNotesTerms)

    If sourceCriteriaCount < MIN_SOURCE_CRITERIA Then

        Err.Raise _
            vbObjectError + 2102, _
            "FindSimilarIncidents", _
            "The selected record does not contain enough information " & _
            "for a meaningful comparison." & _
            vbCrLf & vbCrLf & _
            "Enter at least two of the following before searching:" & _
            vbCrLf & _
            "UUT, serial number, Test, test path, Fault, or Notes."

    End If

    sourceSummary = BuildSourceSummary(sourceRecord, sourceNotesTerms)

    recordsEvaluated = 0

    Set matches = New Collection

    For candidateIndex = 1 To UBound(dataValues, 1)

        candidateWorksheetRow = firstDataRow + candidateIndex - 1

        If candidateWorksheetRow <> sourceRecord.WorksheetRow Then

            If IncidentArrayRowHasContent(dataValues, candidateIndex) Then

                recordsEvaluated = recordsEvaluated + 1

                LoadIncidentRecord _
                    candidateRecord, _
                    dataValues, _
                    idValues, _
                    candidateIndex, _
                    candidateWorksheetRow, _
                    columns

                Set candidateMatch = BuildIncidentMatch( _
                    sourceRecord, _
                    candidateRecord, _
                    sourceFaultTerms, _
                    sourceNotesTerms, _
                    sourceCriteriaCount)

                If Not candidateMatch Is Nothing Then
                    AddRankedIncidentMatch matches, candidateMatch
                End If

            End If

        End If

    Next candidateIndex

    Set FindSimilarIncidents = matches

End Function


Public Sub OpenSimilarIncidentRow(ByVal WorksheetRow As Long)

    Dim ws As Worksheet
    Dim dataTable As ListObject
    Dim firstDataRow As Long
    Dim lastDataRow As Long

    Set ws = ThisWorkbook.Worksheets(INCIDENT_SHEET_NAME)
    Set dataTable = ws.ListObjects(INCIDENT_TABLE_NAME)

    firstDataRow = dataTable.HeaderRowRange.Row + 1
    lastDataRow = GetLastIncidentDataRow(dataTable)

    If WorksheetRow < firstDataRow Or WorksheetRow > lastDataRow Then

        MsgBox _
            "The selected historical record is no longer available.", _
            vbExclamation, _
            "Similar Incidents"

        Exit Sub

    End If

    ws.Activate

    Application.GoTo _
        Reference:=ws.Cells(WorksheetRow, dataTable.Range.Column), _
        Scroll:=True

End Sub


'============================================================
' RECORD LOADING
'============================================================

Private Sub LoadIncidentColumnMap( _
    ByVal dataTable As ListObject, _
    ByRef columns As IncidentColumnMap _
)

    columns.DateIndex = dataTable.ListColumns("Date").Index
    columns.UUTIndex = dataTable.ListColumns("UUT").Index
    columns.SerialNumberIndex = dataTable.ListColumns("SN").Index
    columns.TestIndex = dataTable.ListColumns("Test").Index
    columns.PathStartIndex = dataTable.ListColumns("Test Step").Index
    columns.FaultIndex = dataTable.ListColumns("Fault").Index
    columns.CauseIndex = dataTable.ListColumns("Cause").Index
    columns.ResolutionIndex = dataTable.ListColumns("Resolution").Index
    columns.NotesIndex = dataTable.ListColumns("Notes").Index

End Sub


Private Sub LoadIncidentRecord( _
    ByRef record As IncidentRecordData, _
    ByRef dataValues As Variant, _
    ByRef idValues As Variant, _
    ByVal rowIndex As Long, _
    ByVal WorksheetRow As Long, _
    ByRef columns As IncidentColumnMap _
)

    Dim pathLevel As Long

    record.WorksheetRow = WorksheetRow

    record.DateText = FormatIncidentDate(dataValues(rowIndex, columns.DateIndex))
    record.UUT = IncidentText(dataValues(rowIndex, columns.UUTIndex))
    record.serialNumber = IncidentText(dataValues(rowIndex, columns.SerialNumberIndex))
    record.testName = IncidentText(dataValues(rowIndex, columns.TestIndex))

    For pathLevel = 1 To 5

        record.PathValues(pathLevel) = _
            IncidentText(dataValues(rowIndex, columns.PathStartIndex + pathLevel - 1))

        record.PathIDs(pathLevel) = IncidentText(idValues(rowIndex, pathLevel))

    Next pathLevel

    record.TestPath = BuildIncidentTestPath(record)

    record.FaultText = IncidentText(dataValues(rowIndex, columns.FaultIndex))
    record.CauseText = IncidentText(dataValues(rowIndex, columns.CauseIndex))
    record.ResolutionText = IncidentText(dataValues(rowIndex, columns.ResolutionIndex))
    record.NotesText = IncidentText(dataValues(rowIndex, columns.NotesIndex))

End Sub


Private Function IncidentArrayRowHasContent( _
    ByRef dataValues As Variant, _
    ByVal rowIndex As Long _
) As Boolean

    Dim columnIndex As Long
    Dim cellValue As Variant

    For columnIndex = LBound(dataValues, 2) To UBound(dataValues, 2)

        cellValue = dataValues(rowIndex, columnIndex)

        If Not IsError(cellValue) Then

            If Len(Trim$(CStr(cellValue))) > 0 Then

                IncidentArrayRowHasContent = True

                Exit Function

            End If

        End If

    Next columnIndex

End Function


Private Function GetLastIncidentDataRow(ByVal dataTable As ListObject) As Long

    Dim lastCell As Range

    ' Edge Case Defense:
    ' Tables with no rows are considered to have no incident data.
    If dataTable.DataBodyRange Is Nothing Then

        GetLastIncidentDataRow = dataTable.HeaderRowRange.Row

        Exit Function

    End If

    Set lastCell = dataTable.DataBodyRange.Find( _
        What:="*", _
        After:=dataTable.DataBodyRange.Cells(1, 1), _
        LookIn:=xlValues, _
        LookAt:=xlPart, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, _
        MatchCase:=False)

    ' Edge Case Defense:
    ' DataBodyRange can exist while containing no populated cells.
    If lastCell Is Nothing Then

        GetLastIncidentDataRow = dataTable.HeaderRowRange.Row

    Else

        GetLastIncidentDataRow = lastCell.Row

    End If

End Function


'============================================================
' SCORING
'============================================================

Private Function BuildIncidentMatch( _
    ByRef sourceRecord As IncidentRecordData, _
    ByRef candidateRecord As IncidentRecordData, _
    ByVal sourceFaultTerms As Collection, _
    ByVal sourceNotesTerms As Collection, _
    ByVal sourceCriteriaCount As Long _
) As clsIncidentMatch

    Dim candidateFaultTerms As Collection
    Dim candidateNotesTerms As Collection
    Dim result As clsIncidentMatch

    Dim earnedPoints As Long
    Dim possiblePoints As Long
    Dim criterionPoints As Long
    Dim scoreValue As Long

    Dim overlapRatio As Double
    Dim reasonsText As String
    Dim differencesText As String
    Dim sharedTerms As String

    '----------------------------------------------------
    ' UUT
    '----------------------------------------------------
    If IsMeaningfulIncidentText(sourceRecord.UUT) Then

        possiblePoints = possiblePoints + WEIGHT_UUT

        If IncidentValuesMatch(sourceRecord.UUT, candidateRecord.UUT) Then

            earnedPoints = earnedPoints + WEIGHT_UUT

            AppendReasonLine reasonsText, "Same UUT"

        Else

            AppendReasonLine _
                differencesText, _
                "UUT differs: " & DisplayIncidentValue(candidateRecord.UUT)

        End If

    End If

    '----------------------------------------------------
    ' SERIAL NUMBER
    '----------------------------------------------------
    If IsMeaningfulIncidentText(sourceRecord.serialNumber) Then

        possiblePoints = possiblePoints + WEIGHT_SERIAL_NUMBER

        If IncidentValuesMatch(sourceRecord.serialNumber, candidateRecord.serialNumber) Then

            earnedPoints = earnedPoints + WEIGHT_SERIAL_NUMBER

            AppendReasonLine reasonsText, "Same serial number"

        ElseIf IsMeaningfulIncidentText(candidateRecord.serialNumber) Then

            AppendReasonLine _
                differencesText, _
                "Serial number differs: " & candidateRecord.serialNumber

        End If

    End If

    '----------------------------------------------------
    ' TEST
    '----------------------------------------------------
    If IsMeaningfulIncidentText(sourceRecord.testName) Then

        possiblePoints = possiblePoints + WEIGHT_TEST

        If IncidentValuesMatch(sourceRecord.testName, candidateRecord.testName) Then

            earnedPoints = earnedPoints + WEIGHT_TEST

            AppendReasonLine reasonsText, "Same Test"

        Else

            AppendReasonLine _
                differencesText, _
                "Test differs: " & DisplayIncidentValue(candidateRecord.testName)

        End If

    End If

    '----------------------------------------------------
    ' TEST PATH
    '----------------------------------------------------
    If GetIncidentPathDepth(sourceRecord) > 0 Then

        possiblePoints = possiblePoints + WEIGHT_TEST_PATH

        criterionPoints = GetIncidentPathMatchPoints( _
            sourceRecord, _
            candidateRecord, _
            reasonsText, _
            differencesText)

        earnedPoints = earnedPoints + criterionPoints

    End If

    '----------------------------------------------------
    ' EXACT FAULT
    '----------------------------------------------------
    If IsMeaningfulIncidentText(sourceRecord.FaultText) Then

        possiblePoints = possiblePoints + WEIGHT_FAULT_EXACT

        If IncidentValuesMatch(sourceRecord.FaultText, candidateRecord.FaultText) Then

            earnedPoints = earnedPoints + WEIGHT_FAULT_EXACT

            AppendReasonLine reasonsText, "Exact Fault match"

        ElseIf IsMeaningfulIncidentText(candidateRecord.FaultText) Then

            AppendReasonLine differencesText, "Fault text differs"

        End If

    End If

    '----------------------------------------------------
    ' FAULT TERMS
    '----------------------------------------------------
    If sourceFaultTerms.Count > 0 Then

        possiblePoints = possiblePoints + WEIGHT_FAULT_TERMS

        Set candidateFaultTerms = GetIncidentTerms(candidateRecord.FaultText)

        overlapRatio = GetIncidentTermOverlap( _
            sourceFaultTerms, _
            candidateFaultTerms, _
            sharedTerms)

        criterionPoints = RoundIncidentValue(WEIGHT_FAULT_TERMS * overlapRatio)

        earnedPoints = earnedPoints + criterionPoints

        If criterionPoints > 0 Then

            AppendReasonLine _
                reasonsText, _
                "Fault term overlap " & Format$(overlapRatio, "0%") & ": " & sharedTerms

        End If

    End If

    '----------------------------------------------------
    ' NOTES TERMS
    '----------------------------------------------------
    If sourceNotesTerms.Count > 0 Then

        possiblePoints = possiblePoints + WEIGHT_NOTES_TERMS

        Set candidateNotesTerms = GetIncidentTerms(candidateRecord.NotesText)

        overlapRatio = GetIncidentTermOverlap( _
            sourceNotesTerms, _
            candidateNotesTerms, _
            sharedTerms)

        criterionPoints = RoundIncidentValue(WEIGHT_NOTES_TERMS * overlapRatio)

        earnedPoints = earnedPoints + criterionPoints

        If criterionPoints > 0 Then

            AppendReasonLine _
                reasonsText, _
                "Notes term overlap " & Format$(overlapRatio, "0%") & ": " & sharedTerms

        End If

    End If

    If possiblePoints = 0 Then Exit Function

    scoreValue = RoundIncidentValue(earnedPoints * 100# / possiblePoints)

    If scoreValue < MIN_RESULT_SCORE Then Exit Function

    Set result = New clsIncidentMatch

    result.WorksheetRow = candidateRecord.WorksheetRow
    result.Score = scoreValue
    result.EvidenceCount = sourceCriteriaCount
    result.MatchLevel = GetIncidentMatchLevel(scoreValue, sourceCriteriaCount)

    result.DateText = candidateRecord.DateText
    result.UUT = candidateRecord.UUT
    result.serialNumber = candidateRecord.serialNumber
    result.testName = candidateRecord.testName
    result.TestPath = candidateRecord.TestPath

    result.FaultText = candidateRecord.FaultText
    result.CauseText = candidateRecord.CauseText
    result.ResolutionText = candidateRecord.ResolutionText
    result.NotesText = candidateRecord.NotesText

    result.reasonsText = reasonsText
    result.differencesText = differencesText

    Set BuildIncidentMatch = result

End Function


Private Function GetIncidentPathMatchPoints( _
    ByRef sourceRecord As IncidentRecordData, _
    ByRef candidateRecord As IncidentRecordData, _
    ByRef reasonsText As String, _
    ByRef differencesText As String _
) As Long

    Dim sourceDepth As Long
    Dim sharedDepth As Long
    Dim pathLevel As Long
    Dim levelOverlap As Double
    Dim totalOverlap As Double
    Dim pathOverlap As Double
    Dim fullPathMatch As Boolean

    sourceDepth = GetIncidentPathDepth(sourceRecord)
    fullPathMatch = True

    For pathLevel = 1 To sourceDepth

        levelOverlap = HierarchySelectionOverlap( _
            sourceRecord.PathValues(pathLevel), _
            sourceRecord.PathIDs(pathLevel), _
            candidateRecord.PathValues(pathLevel), _
            candidateRecord.PathIDs(pathLevel))

        If levelOverlap <= 0 Then
            fullPathMatch = False
            Exit For
        End If

        totalOverlap = totalOverlap + levelOverlap
        sharedDepth = pathLevel

        If Not IncidentPathLevelMatches( _
                sourceRecord.PathValues(pathLevel), _
                sourceRecord.PathIDs(pathLevel), _
                candidateRecord.PathValues(pathLevel), _
                candidateRecord.PathIDs(pathLevel)) Then

            fullPathMatch = False

        End If

        If pathLevel < sourceDepth Then

            If Not HierarchyBranchSelectionsMatch( _
                    IncidentPathFieldName(pathLevel), _
                    sourceRecord.PathValues(pathLevel), _
                    sourceRecord.PathIDs(pathLevel), _
                    candidateRecord.PathValues(pathLevel), _
                    candidateRecord.PathIDs(pathLevel)) Then

                fullPathMatch = False
                Exit For

            End If

        End If

    Next pathLevel

    If sharedDepth = 0 Then

        AppendReasonLine differencesText, "Test path differs"

        Exit Function

    End If

    pathOverlap = totalOverlap / sourceDepth
    GetIncidentPathMatchPoints = RoundIncidentValue(WEIGHT_TEST_PATH * pathOverlap)

    If fullPathMatch And sharedDepth = sourceDepth Then

        AppendReasonLine reasonsText, "Source test path fully matches"

    Else

        AppendReasonLine _
            reasonsText, _
            "Test path overlap " & Format$(pathOverlap, "0%") & _
            " through " & IncidentPathFieldName(sharedDepth)

    End If

End Function


Private Function IncidentPathLevelMatches( _
    ByVal sourceValue As String, _
    ByVal sourceNodeIDs As String, _
    ByVal candidateValue As String, _
    ByVal candidateNodeIDs As String _
) As Boolean

    IncidentPathLevelMatches = _
        (Abs(HierarchySelectionOverlap( _
            sourceValue, _
            sourceNodeIDs, _
            candidateValue, _
            candidateNodeIDs) - 1#) < 0.0001)

End Function


Private Function RoundIncidentValue(ByVal sourceValue As Double) As Long

    RoundIncidentValue = CLng(Fix(sourceValue + 0.5))

End Function


Private Function GetIncidentMatchLevel( _
    ByVal scoreValue As Long, _
    ByVal EvidenceCount As Long _
) As String

    If scoreValue >= 80 And EvidenceCount >= 4 Then

        GetIncidentMatchLevel = "Strong Match"

    ElseIf scoreValue >= 65 And EvidenceCount >= 3 Then

        GetIncidentMatchLevel = "Good Match"

    ElseIf scoreValue >= 40 Then

        GetIncidentMatchLevel = "Possible Match"

    Else

        GetIncidentMatchLevel = "Weak Match"

    End If

End Function


Private Sub AddRankedIncidentMatch( _
    ByVal matches As Collection, _
    ByVal candidateMatch As clsIncidentMatch _
)

    Dim existingMatch As clsIncidentMatch
    Dim matchIndex As Long
    Dim inserted As Boolean

    For matchIndex = 1 To matches.Count

        Set existingMatch = matches(matchIndex)

        If candidateMatch.Score > existingMatch.Score _
            Or (candidateMatch.Score = existingMatch.Score _
                And candidateMatch.WorksheetRow < existingMatch.WorksheetRow) Then

            matches.Add candidateMatch, Before:=matchIndex

            inserted = True

            Exit For

        End If

    Next matchIndex

    If Not inserted Then
        matches.Add candidateMatch
    End If

    If matches.Count > MAX_MATCH_RESULTS Then
        matches.Remove matches.Count
    End If

End Sub


'============================================================
' SOURCE SUMMARY
'============================================================

Private Function CountSourceCriteria( _
    ByRef sourceRecord As IncidentRecordData, _
    ByVal sourceNotesTerms As Collection _
) As Long

    If IsMeaningfulIncidentText(sourceRecord.UUT) Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

    If IsMeaningfulIncidentText(sourceRecord.serialNumber) Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

    If IsMeaningfulIncidentText(sourceRecord.testName) Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

    If GetIncidentPathDepth(sourceRecord) > 0 Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

    If IsMeaningfulIncidentText(sourceRecord.FaultText) Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

    If sourceNotesTerms.Count > 0 Then
        CountSourceCriteria = CountSourceCriteria + 1
    End If

End Function


Private Function BuildSourceSummary( _
    ByRef sourceRecord As IncidentRecordData, _
    ByVal sourceNotesTerms As Collection _
) As String

    Dim summaryText As String
    Dim criteriaText As String

    AppendPlainLine summaryText, "Worksheet Row: " & CStr(sourceRecord.WorksheetRow)

    If Len(sourceRecord.DateText) > 0 Then
        AppendPlainLine summaryText, "Date: " & sourceRecord.DateText
    End If

    AppendPlainLine _
        summaryText, _
        "UUT: " & DisplayIncidentValue(sourceRecord.UUT) & _
        "    SN: " & DisplayIncidentValue(sourceRecord.serialNumber) & _
        "    Test: " & DisplayIncidentValue(sourceRecord.testName)

    If Len(sourceRecord.TestPath) > 0 Then
        AppendPlainLine summaryText, "Path: " & sourceRecord.TestPath
    End If

    If Len(sourceRecord.FaultText) > 0 Then
        AppendPlainLine summaryText, "Fault: " & sourceRecord.FaultText
    End If

    AppendSourceCriterionName _
        criteriaText, _
        "UUT", _
        IsMeaningfulIncidentText(sourceRecord.UUT)

    AppendSourceCriterionName _
        criteriaText, _
        "Serial Number", _
        IsMeaningfulIncidentText(sourceRecord.serialNumber)

    AppendSourceCriterionName _
        criteriaText, _
        "Test", _
        IsMeaningfulIncidentText(sourceRecord.testName)

    AppendSourceCriterionName _
        criteriaText, _
        "Test Path", _
        (GetIncidentPathDepth(sourceRecord) > 0)

    AppendSourceCriterionName _
        criteriaText, _
        "Fault", _
        IsMeaningfulIncidentText(sourceRecord.FaultText)

    AppendSourceCriterionName _
        criteriaText, _
        "Notes", _
        (sourceNotesTerms.Count > 0)

    summaryText = summaryText & vbCrLf & vbCrLf & "Criteria used: " & criteriaText

    BuildSourceSummary = summaryText

End Function


Private Sub AppendSourceCriterionName( _
    ByRef criteriaText As String, _
    ByVal criterionName As String, _
    ByVal includeCriterion As Boolean _
)

    If Not includeCriterion Then Exit Sub

    If Len(criteriaText) > 0 Then
        criteriaText = criteriaText & ", "
    End If

    criteriaText = criteriaText & criterionName

End Sub


'============================================================
' PATH HELPERS
'============================================================

Private Function BuildIncidentTestPath(ByRef record As IncidentRecordData) As String

    Dim pathText As String
    Dim pathLevel As Long

    For pathLevel = 1 To 5

        If Not IsMeaningfulIncidentText(record.PathValues(pathLevel)) Then Exit For

        If Len(pathText) > 0 Then
            pathText = pathText & " > "
        End If

        pathText = pathText & FormatHierarchySelectionForDisplay( _
            record.PathValues(pathLevel))

    Next pathLevel

    BuildIncidentTestPath = pathText

End Function


Private Function GetIncidentPathDepth(ByRef record As IncidentRecordData) As Long

    Dim pathLevel As Long

    For pathLevel = 1 To 5

        If Not IsMeaningfulIncidentText(record.PathValues(pathLevel)) Then Exit For

        GetIncidentPathDepth = pathLevel

    Next pathLevel

End Function


Private Function IncidentPathFieldName(ByVal pathLevel As Long) As String

    Select Case pathLevel

        Case 1
            IncidentPathFieldName = "Test Step"

        Case 2
            IncidentPathFieldName = "Sub Step 1"

        Case 3
            IncidentPathFieldName = "Sub Step 2"

        Case 4
            IncidentPathFieldName = "Sub Step 3"

        Case 5
            IncidentPathFieldName = "Sub Step 4"

    End Select

End Function


'============================================================
' TEXT COMPARISON
'============================================================

Private Function GetIncidentTerms(ByVal sourceText As String) As Collection

    Dim terms As Collection
    Dim rawTerms As Variant
    Dim rawTerm As Variant

    Dim normalizedText As String
    Dim token As String

    Set terms = New Collection

    normalizedText = NormalizeIncidentTokenText(sourceText)

    If Len(normalizedText) = 0 Then

        Set GetIncidentTerms = terms

        Exit Function

    End If

    rawTerms = Split(normalizedText, " ")

    For Each rawTerm In rawTerms

        token = Trim$(CStr(rawTerm))

        If Len(token) >= 2 Then

            If Not IsIncidentStopWord(token) Then

                If Not IncidentCollectionContains(terms, token) Then
                    terms.Add token
                End If

            End If

        End If

    Next rawTerm

    Set GetIncidentTerms = terms

End Function


Private Function NormalizeIncidentTokenText(ByVal sourceText As String) As String

    Dim normalizedText As String
    Dim character As String
    Dim characterCode As Long
    Dim characterIndex As Long

    For characterIndex = 1 To Len(sourceText)

        character = Mid$(sourceText, characterIndex, 1)
        characterCode = AscW(character)

        If (characterCode >= 48 And characterCode <= 57) _
            Or (characterCode >= 65 And characterCode <= 90) _
            Or (characterCode >= 97 And characterCode <= 122) Then

            normalizedText = normalizedText & LCase$(character)

        Else

            normalizedText = normalizedText & " "

        End If

    Next characterIndex

    normalizedText = Trim$(normalizedText)

    Do While InStr(1, normalizedText, "  ", vbBinaryCompare) > 0
        normalizedText = Replace(normalizedText, "  ", " ")
    Loop

    NormalizeIncidentTokenText = normalizedText

End Function


Private Function IsIncidentStopWord(ByVal token As String) As Boolean

    Select Case token

        Case _
            "a", "an", "and", "are", "as", "at", _
            "be", "by", "for", "from", "in", "is", _
            "it", "of", "on", "or", "the", "to", _
            "was", "were", "with", "this", "that", _
            "test", "dummy", "entry", "entries", _
            "purpose", "purposes", "only"

            IsIncidentStopWord = True

    End Select

End Function


Private Function GetIncidentTermOverlap( _
    ByVal sourceTerms As Collection, _
    ByVal candidateTerms As Collection, _
    ByRef sharedTerms As String _
) As Double

    Dim sourceTerm As Variant
    Dim sharedCount As Long

    sharedTerms = vbNullString

    If sourceTerms.Count = 0 Then Exit Function

    For Each sourceTerm In sourceTerms

        If IncidentCollectionContains(candidateTerms, CStr(sourceTerm)) Then

            sharedCount = sharedCount + 1

            If sharedCount <= 6 Then

                If Len(sharedTerms) > 0 Then
                    sharedTerms = sharedTerms & ", "
                End If

                sharedTerms = sharedTerms & CStr(sourceTerm)

            End If

        End If

    Next sourceTerm

    GetIncidentTermOverlap = sharedCount / sourceTerms.Count

End Function


Private Function IncidentCollectionContains( _
    ByVal values As Collection, _
    ByVal searchValue As String _
) As Boolean

    Dim value As Variant

    For Each value In values

        If StrComp(CStr(value), searchValue, vbTextCompare) = 0 Then

            IncidentCollectionContains = True

            Exit Function

        End If

    Next value

End Function


Private Function IncidentValuesMatch( _
    ByVal firstValue As String, _
    ByVal secondValue As String _
) As Boolean

    If Not IsMeaningfulIncidentText(firstValue) _
        Or Not IsMeaningfulIncidentText(secondValue) Then Exit Function

    IncidentValuesMatch = (StrComp( _
        Trim$(firstValue), _
        Trim$(secondValue), _
        vbTextCompare) = 0)

End Function


Private Function IsMeaningfulIncidentText(ByVal sourceText As String) As Boolean

    sourceText = Trim$(sourceText)

    IsMeaningfulIncidentText = Len(sourceText) > 0 _
        And StrComp(sourceText, "-", vbBinaryCompare) <> 0

End Function


Private Function IncidentText(ByVal cellValue As Variant) As String

    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function

    IncidentText = Trim$(CStr(cellValue))

End Function


Private Function FormatIncidentDate(ByVal cellValue As Variant) As String

    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function

    If IsDate(cellValue) Then

        FormatIncidentDate = Format$(CDate(cellValue), "dd-mmm-yyyy")

    Else

        FormatIncidentDate = IncidentText(cellValue)

    End If

End Function


Private Function DisplayIncidentValue(ByVal sourceText As String) As String

    If Len(Trim$(sourceText)) = 0 Then

        DisplayIncidentValue = "(blank)"

    Else

        DisplayIncidentValue = sourceText

    End If

End Function


Private Sub AppendReasonLine( _
    ByRef targetText As String, _
    ByVal lineText As String _
)

    If Len(lineText) = 0 Then Exit Sub

    If Len(targetText) > 0 Then
        targetText = targetText & vbCrLf
    End If

    targetText = targetText & "- " & lineText

End Sub


Private Sub AppendPlainLine( _
    ByRef targetText As String, _
    ByVal lineText As String _
)

    If Len(lineText) = 0 Then Exit Sub

    If Len(targetText) > 0 Then
        targetText = targetText & vbCrLf
    End If

    targetText = targetText & lineText

End Sub


