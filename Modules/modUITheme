'============================================================
' PICKER THEME APPLICATION
'============================================================

Public Sub ApplyUIPickerTheme( _
    ByVal lbl As MSForms.Label, _
    ByVal fieldName As String, _
    ByVal ItemValue As String _
)

    Dim fillColor As Long
    Dim textColor As Long
    Dim isBold As Boolean

    '----------------------------------------------------
    ' DEFAULT APPEARANCE
    '----------------------------------------------------
    lbl.BackColor = _
        UIColor_ItemBackground()

    lbl.ForeColor = _
        UIColor_ItemText()

    lbl.BorderColor = _
        UIColor_ItemBorder()

    lbl.Font.Name = _
        UI_FONT

    lbl.Font.Size = _
        UI_ITEM_FONT_SIZE

    lbl.Font.Bold = _
        False

    '----------------------------------------------------
    ' SEMANTIC COLOR OVERRIDE
    '----------------------------------------------------
    ' tbl_Theme controls picker color, but Bold is intentionally
    ' reserved for worksheet-cell theming.
    If TryGetTheme( _
            fieldName, _
            ItemValue, _
            fillColor, _
            textColor, _
            isBold) Then

        lbl.BackColor = _
            fillColor

        lbl.ForeColor = _
            textColor

        lbl.BorderColor = _
            UIDarkenColor( _
                fillColor, _
                UI_THEME_BORDER_DARKEN)

    End If

End Sub


'============================================================
' COLOR UTILITIES
'============================================================

Public Function UILightenColor( _
    ByVal sourceColor As Long, _
    ByVal amount As Double _
) As Long

    UILightenColor = _
        UIBlendColor( _
            sourceColor, _
            RGB(255, 255, 255), _
            amount)

End Function


Public Function UIDarkenColor( _
    ByVal sourceColor As Long, _
    ByVal amount As Double _
) As Long

    UIDarkenColor = _
        UIBlendColor( _
            sourceColor, _
            RGB(0, 0, 0), _
            amount)

End Function


Private Function UIBlendColor( _
    ByVal sourceColor As Long, _
    ByVal targetColor As Long, _
    ByVal amount As Double _
) As Long

    Dim sourceR As Long
    Dim sourceG As Long
    Dim sourceB As Long

    Dim targetR As Long
    Dim targetG As Long
    Dim targetB As Long

    Dim resultR As Long
    Dim resultG As Long
    Dim resultB As Long

    ' Edge Case Defense:
    ' Clamp blend factor to the valid interpolation range.
    If amount < 0 Then
        amount = 0
    End If

    If amount > 1 Then
        amount = 1
    End If

    ' VBA RGB() stores channels as BGR within the Long value.
    sourceR = _
        sourceColor And &HFF&

    sourceG = _
        (sourceColor \ &H100&) _
        And &HFF&

    sourceB = _
        (sourceColor \ &H10000) _
        And &HFF&

    targetR = _
        targetColor And &HFF&

    targetG = _
        (targetColor \ &H100&) _
        And &HFF&

    targetB = _
        (targetColor \ &H10000) _
        And &HFF&

    resultR = _
        CLng( _
            sourceR + _
            ((targetR - sourceR) * amount))

    resultG = _
        CLng( _
            sourceG + _
            ((targetG - sourceG) * amount))

    resultB = _
        CLng( _
            sourceB + _
            ((targetB - sourceB) * amount))

    UIBlendColor = _
        RGB( _
            resultR, _
            resultG, _
            resultB)

End Function

