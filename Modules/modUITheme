'============================================================
' PICKER THEME APPLICATION
'============================================================

Public Sub ApplyUIPickerTheme( _
    ByVal lbl As MSForms.Label, _
    ByVal fieldName As String, _
    ByVal itemValue As String _
)

    Dim fillColor As Long
    Dim textColor As Long
    Dim isBold As Boolean

    '----------------------------------------------------
    ' DEFAULT APPEARANCE
    '----------------------------------------------------
    lbl.BackColor = UIColor_ItemBackground()
    lbl.ForeColor = UIColor_ItemText()
    lbl.BorderColor = UIColor_ItemBorder()
    lbl.Font.Name = UI_FONT
    lbl.Font.Size = UI_ITEM_FONT_SIZE
    lbl.Font.Bold = False

    '----------------------------------------------------
    ' SEMANTIC COLOR OVERRIDE
    '----------------------------------------------------
    ' Picker typography deliberately ignores worksheet Bold theme rules.
    If TryGetTheme(fieldName, itemValue, fillColor, textColor, isBold) Then

        lbl.BackColor = fillColor
        lbl.ForeColor = textColor
        lbl.BorderColor = UIDarkenColor(fillColor, UI_THEME_BORDER_DARKEN)

    End If

End Sub


'============================================================
' COLOR UTILITIES
'============================================================

Public Function UILightenColor(ByVal sourceColor As Long, ByVal amount As Double) As Long

    UILightenColor = UIBlendColor(sourceColor, RGB(255, 255, 255), amount)

End Function


Public Function UIDarkenColor(ByVal sourceColor As Long, ByVal amount As Double) As Long

    UIDarkenColor = UIBlendColor(sourceColor, RGB(0, 0, 0), amount)

End Function


Private Function UIBlendColor( _
    ByVal sourceColor As Long, _
    ByVal targetColor As Long, _
    ByVal amount As Double _
) As Long

    Dim sourceR As Long
    Dim sourceG As Long
    Dim sourceB As Long

    Dim targetR As Long
    Dim targetG As Long
    Dim targetB As Long

    Dim resultR As Long
    Dim resultG As Long
    Dim resultB As Long

    ' Edge Case Defense:
    ' Public color helpers accept arbitrary blend amounts.
    If amount < 0 Then amount = 0
    If amount > 1 Then amount = 1

    ' VBA RGB stores channels as BGR within the Long value.
    sourceR = sourceColor And &HFF&
    sourceG = (sourceColor \ &H100&) And &HFF&
    sourceB = (sourceColor \ &H10000) And &HFF&

    targetR = targetColor And &HFF&
    targetG = (targetColor \ &H100&) And &HFF&
    targetB = (targetColor \ &H10000) And &HFF&

    resultR = CLng(sourceR + ((targetR - sourceR) * amount))
    resultG = CLng(sourceG + ((targetG - sourceG) * amount))
    resultB = CLng(sourceB + ((targetB - sourceB) * amount))

    UIBlendColor = RGB(resultR, resultG, resultB)

End Function

