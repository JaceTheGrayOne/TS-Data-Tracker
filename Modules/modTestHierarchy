Option Explicit


'============================================================
' CONFIGURATION
'============================================================

Private Const OUTLINE_TABLE_NAME As String = "tbl_TestOutline"
Private Const HIERARCHY_TABLE_NAME As String = "tbl_TestHierarchy"

Private Const GENERATED_ID_PREFIX As String = "TN-"


'============================================================
' PUBLIC INTERFACE
'============================================================

Public Sub RebuildTestHierarchy()

    Dim outline As ListObject
    Dim hierarchy As ListObject

    Dim outlineRow As listRow
    Dim hierarchyRow As listRow

    Dim usedIDs As Object
    Dim lastNodeAtDepth As Object

    Dim colTest As Long
    Dim colNodeID As Long
    Dim colRawLine As Long

    Dim outColTest As Long
    Dim outColNodeID As Long
    Dim outColParentID As Long
    Dim outColLabel As Long
    Dim outColDepth As Long
    Dim outColSort As Long
    Dim outColSourceRow As Long

    Dim currentTest As String
    Dim testMarker As String

    Dim rawLine As String
    Dim nodeID As String
    Dim ParentID As String
    Dim labelText As String

    Dim Depth As Long
    Dim previousDepth As Long
    Dim maximumDepth As Long

    Dim SortOrder As Long
    Dim nextNodeNumber As Long
    Dim parsedCount As Long

    Dim oldEnableEvents As Boolean
    Dim oldScreenUpdating As Boolean

    Dim savedErrNumber As Long
    Dim savedErrDescription As String

    Dim key As Variant
    Dim keys As Variant

    On Error GoTo Fail

    ' Capture application state before any operation that can fail.
    ' Not doing this can lead to an earlier op throwing before variable
    ' capture that could cause the cleanup handler to restore some
    ' variable's default boolean to False erroneously.
    oldEnableEvents = Application.EnableEvents
    oldScreenUpdating = Application.ScreenUpdating

    Set outline = FindHierarchyTable(OUTLINE_TABLE_NAME)
    Set hierarchy = FindHierarchyTable(HIERARCHY_TABLE_NAME)

    If outline Is Nothing Then

        Err.Raise _
            vbObjectError + 1600, _
            "modTestHierarchy.RebuildTestHierarchy", _
            "Could not find table '" & OUTLINE_TABLE_NAME & "'."

    End If

    If hierarchy Is Nothing Then

        Err.Raise _
            vbObjectError + 1601, _
            "modTestHierarchy.RebuildTestHierarchy", _
            "Could not find table '" & HIERARCHY_TABLE_NAME & "'."

    End If

    ' Edge Case Defense:
    ' An empty source outline cannot safely replace an existing generated hierarchy.
    If Not OutlineContainsPopulatedLines(outline) Then

        Err.Raise _
            vbObjectError + 1607, _
            "modTestHierarchy.RebuildTestHierarchy", _
            "tbl_TestOutline contains no populated Raw Line values. The existing hierarchy was not changed."

    End If

    '----------------------------------------------------
    ' COLUMN MAPPING
    '----------------------------------------------------
    colTest = outline.ListColumns("Test").Index
    colNodeID = outline.ListColumns("Node ID").Index
    colRawLine = outline.ListColumns("Raw Line").Index

    outColTest = hierarchy.ListColumns("Test").Index
    outColNodeID = hierarchy.ListColumns("Node ID").Index
    outColParentID = hierarchy.ListColumns("Parent ID").Index
    outColLabel = hierarchy.ListColumns("Label").Index
    outColDepth = hierarchy.ListColumns("Depth").Index
    outColSort = hierarchy.ListColumns("Sort Order").Index
    outColSourceRow = hierarchy.ListColumns("Source Row").Index

    Application.EnableEvents = False
    Application.ScreenUpdating = False

    Set usedIDs = CreateObject("Scripting.Dictionary")
    usedIDs.CompareMode = vbTextCompare

    '----------------------------------------------------
    ' FIRST PASS - EXISTING NODE IDS
    '----------------------------------------------------
    ' Existing IDs remain stable across rebuilds.
    nextNodeNumber = 1

    For Each outlineRow In outline.ListRows

        nodeID = Trim$(CStr(outlineRow.Range.Cells(1, colNodeID).value2))

        If Len(nodeID) > 0 Then

            If usedIDs.Exists(nodeID) Then

                Err.Raise _
                    vbObjectError + 1602, _
                    "modTestHierarchy.RebuildTestHierarchy", _
                    "Duplicate Node ID '" & nodeID & "' in tbl_TestOutline."

            End If

            usedIDs.Add nodeID, True

            UpdateNextGeneratedNodeNumber nodeID, nextNodeNumber

        End If

    Next outlineRow

    '----------------------------------------------------
    ' GENERATED HIERARCHY
    '----------------------------------------------------
    Do While hierarchy.ListRows.Count > 0
        hierarchy.ListRows(1).Delete
    Loop

    Set lastNodeAtDepth = CreateObject("Scripting.Dictionary")

    currentTest = vbNullString
    previousDepth = -1
    maximumDepth = 0
    SortOrder = 0
    parsedCount = 0

    '----------------------------------------------------
    ' SECOND PASS - OUTLINE PARSING
    '----------------------------------------------------
    For Each outlineRow In outline.ListRows

        testMarker = Trim$(CStr(outlineRow.Range.Cells(1, colTest).value2))
        rawLine = CStr(outlineRow.Range.Cells(1, colRawLine).value2)

        ' Blank Test cells inherit the current Test.
        ' Repeated Test names do not reset the hierarchy stack.
        If Len(testMarker) > 0 Then

            If StrComp(testMarker, currentTest, vbTextCompare) <> 0 Then

                currentTest = testMarker

                lastNodeAtDepth.RemoveAll

                previousDepth = -1

            End If

        End If

        If Len(Trim$(rawLine)) = 0 Then GoTo NextOutlineRow

        If Len(currentTest) = 0 Then

            Err.Raise _
                vbObjectError + 1603, _
                "modTestHierarchy.RebuildTestHierarchy", _
                "Raw Line exists before any Test has " & _
                "been specified. Worksheet row: " & _
                outlineRow.Range.Row

        End If

        ParseOutlineLine rawLine, Depth, labelText, outlineRow.Range.Row

        ' Edge Case Defense:
        ' Every Test hierarchy must begin at depth 0.
        If previousDepth = -1 And Depth <> 0 Then

            Err.Raise _
                vbObjectError + 1604, _
                "modTestHierarchy.RebuildTestHierarchy", _
                "The first node for Test '" & _
                currentTest & "' must have depth 0." & _
                vbCrLf & _
                "Worksheet row: " & _
                outlineRow.Range.Row

        End If

        ' Edge Case Defense:
        ' Depth can increase by only one level or a parent is missing.
        If previousDepth >= 0 Then

            If Depth > previousDepth + 1 Then

                Err.Raise _
                    vbObjectError + 1605, _
                    "modTestHierarchy.RebuildTestHierarchy", _
                    "Invalid indentation jump from " & _
                    "depth " & previousDepth & _
                    " to depth " & Depth & "." & _
                    vbCrLf & _
                    "Worksheet row: " & _
                    outlineRow.Range.Row & _
                    vbCrLf & _
                    "Raw Line: " & rawLine

            End If

        End If

        ' Generate an ID only for previously unidentified source rows.
        nodeID = Trim$(CStr(outlineRow.Range.Cells(1, colNodeID).value2))

        If Len(nodeID) = 0 Then

            nodeID = GenerateNextNodeID(usedIDs, nextNodeNumber)

            outlineRow.Range.Cells(1, colNodeID).value = nodeID

        End If

        ' Parent is the most recent node one depth level above.
        If Depth = 0 Then

            ParentID = vbNullString

        Else

            If Not lastNodeAtDepth.Exists(CStr(Depth - 1)) Then

                Err.Raise _
                    vbObjectError + 1606, _
                    "modTestHierarchy.RebuildTestHierarchy", _
                    "No parent exists for node '" & _
                    labelText & "' at depth " & Depth & _
                    "." & vbCrLf & _
                    "Worksheet row: " & _
                    outlineRow.Range.Row

            End If

            ParentID = CStr(lastNodeAtDepth(CStr(Depth - 1)))

        End If

        SortOrder = SortOrder + 1
        parsedCount = parsedCount + 1

        If Depth > maximumDepth Then
            maximumDepth = Depth
        End If

        Set hierarchyRow = hierarchy.ListRows.Add

        With hierarchyRow.Range

            .Cells(1, outColTest).value = currentTest
            .Cells(1, outColNodeID).value = nodeID
            .Cells(1, outColParentID).value = ParentID
            .Cells(1, outColLabel).value = labelText
            .Cells(1, outColDepth).value = Depth
            .Cells(1, outColSort).value = SortOrder
            .Cells(1, outColSourceRow).value = outlineRow.Range.Row

        End With

        lastNodeAtDepth(CStr(Depth)) = nodeID

        ' Remove branch state deeper than the current node.
        If lastNodeAtDepth.Count > 0 Then

            keys = lastNodeAtDepth.keys

            For Each key In keys

                If CLng(key) > Depth Then
                    lastNodeAtDepth.Remove key
                End If

            Next key

        End If

        previousDepth = Depth


NextOutlineRow:

    Next outlineRow

    Application.EnableEvents = oldEnableEvents
    Application.ScreenUpdating = oldScreenUpdating

    Debug.Print String(70, "=")
    Debug.Print "TEST HIERARCHY REBUILD"
    Debug.Print String(70, "=")
    Debug.Print "Nodes parsed: " & parsedCount
    Debug.Print "Maximum depth: " & maximumDepth
    Debug.Print String(70, "=")

    Exit Sub


Fail:

    savedErrNumber = Err.Number
    savedErrDescription = Err.description

    On Error Resume Next

    Application.EnableEvents = oldEnableEvents
    Application.ScreenUpdating = oldScreenUpdating

    On Error GoTo 0

    MsgBox _
        "Test hierarchy rebuild failed." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(savedErrNumber) & _
        vbCrLf & _
        savedErrDescription, _
        vbCritical, _
        "Test Hierarchy Error"

End Sub


'============================================================
' OUTLINE PARSING
'============================================================

Private Sub ParseOutlineLine( _
    ByVal rawLine As String, _
    ByRef Depth As Long, _
    ByRef labelText As String, _
    ByVal WorksheetRow As Long _
)

    Dim leadingSpaces As Long
    Dim firstNonSpace As String

    ' Tabs make indentation depth ambiguous.
    If InStr(1, rawLine, vbTab, vbBinaryCompare) > 0 Then

        Err.Raise _
            vbObjectError + 1610, _
            "modTestHierarchy.ParseOutlineLine", _
            "Tabs are not permitted in Raw Line indentation." & _
            vbCrLf & _
            "Worksheet row: " & WorksheetRow

    End If

    leadingSpaces = CountLeadingSpaces(rawLine)

    If leadingSpaces = 0 Then

        ' Root nodes do not use the outline bullet.
        If Left$(rawLine, 1) = "-" Then

            Err.Raise _
                vbObjectError + 1611, _
                "modTestHierarchy.ParseOutlineLine", _
                "A depth-0 node must not begin with '-'." & _
                vbCrLf & _
                "Worksheet row: " & WorksheetRow

        End If

        Depth = 0
        labelText = Trim$(rawLine)

    Else

        firstNonSpace = Mid$(rawLine, leadingSpaces + 1, 1)

        If firstNonSpace <> "-" Then

            Err.Raise _
                vbObjectError + 1612, _
                "modTestHierarchy.ParseOutlineLine", _
                "Indented Raw Line must use '-' after " & _
                "its leading spaces." & _
                vbCrLf & _
                "Worksheet row: " & WorksheetRow & _
                vbCrLf & _
                "Raw Line: " & rawLine

        End If

        Depth = leadingSpaces

        ' Skip the bullet; Trim removes its following space.
        labelText = Trim$(Mid$(rawLine, leadingSpaces + 2))

    End If

    ' Edge Case Defense:
    ' Reject bullet-only or otherwise empty outline entries.
    If Len(labelText) = 0 Then

        Err.Raise _
            vbObjectError + 1613, _
            "modTestHierarchy.ParseOutlineLine", _
            "Parsed test-step label is blank." & _
            vbCrLf & _
            "Worksheet row: " & WorksheetRow

    End If

End Sub


Private Function CountLeadingSpaces(ByVal textValue As String) As Long

    Dim i As Long

    For i = 1 To Len(textValue)

        If Mid$(textValue, i, 1) <> " " Then Exit For

        CountLeadingSpaces = CountLeadingSpaces + 1

    Next i

End Function


'============================================================
' NODE ID MANAGEMENT
'============================================================

Private Function GenerateNextNodeID( _
    ByVal usedIDs As Object, _
    ByRef nextNodeNumber As Long _
) As String

    Dim candidate As String

    Do

        candidate = GENERATED_ID_PREFIX & Format$(nextNodeNumber, "000000")

        nextNodeNumber = nextNodeNumber + 1

    Loop While usedIDs.Exists(candidate)

    usedIDs.Add candidate, True

    GenerateNextNodeID = candidate

End Function


Private Sub UpdateNextGeneratedNodeNumber( _
    ByVal nodeID As String, _
    ByRef nextNodeNumber As Long _
)

    Dim suffix As String
    Dim existingNumber As Long

    If StrComp( _
            Left$(nodeID, Len(GENERATED_ID_PREFIX)), _
            GENERATED_ID_PREFIX, _
            vbTextCompare) <> 0 Then Exit Sub

    suffix = Mid$(nodeID, Len(GENERATED_ID_PREFIX) + 1)

    If Len(suffix) = 0 Then Exit Sub
    If Not IsNumeric(suffix) Then Exit Sub

    existingNumber = CLng(suffix)

    If existingNumber >= nextNodeNumber Then
        nextNodeNumber = existingNumber + 1
    End If

End Sub


'============================================================
' INTERNAL HELPERS
'============================================================

Private Function FindHierarchyTable(ByVal tableName As String) As ListObject

    Dim ws As Worksheet
    Dim tbl As ListObject

    For Each ws In ThisWorkbook.Worksheets

        Set tbl = Nothing

        On Error Resume Next

        Set tbl = ws.ListObjects(tableName)

        On Error GoTo 0

        If Not tbl Is Nothing Then

            Set FindHierarchyTable = tbl

            Exit Function

        End If

    Next ws

End Function

Private Function OutlineContainsPopulatedLines(ByVal sourceTable As ListObject) As Boolean

    Dim rawLineRange As Range
    Dim rawLineValue As Variant
    Dim rowIndex As Long

    If sourceTable.DataBodyRange Is Nothing Then Exit Function

    Set rawLineRange = sourceTable.ListColumns("Raw Line").DataBodyRange

    If rawLineRange Is Nothing Then Exit Function

    For rowIndex = 1 To rawLineRange.Rows.Count

        rawLineValue = rawLineRange.Cells(rowIndex, 1).value2

        If Not IsError(rawLineValue) Then

            If Len(Trim$(CStr(rawLineValue))) > 0 Then

                OutlineContainsPopulatedLines = True

                Exit Function

            End If

        End If

    Next rowIndex

End Function

