Option Explicit


'============================================================
' MODULE STATE
'============================================================

Private mRibbon As Office.IRibbonUI

Private mPresetFilterSearchScheduled As Boolean
Private mPresetFilterSearchTime As Date


'============================================================
' RIBBON LIFECYCLE
'============================================================

Public Sub Ribbon_OnLoad( _
    ByVal ribbon As Office.IRibbonUI _
)

    Set mRibbon = _
        ribbon

End Sub


'============================================================
' SEARCH CALLBACKS
'============================================================

Public Sub Ribbon_RecordSearchChanged( _
    ByVal control As Office.IRibbonControl, _
    ByVal text As String _
)

    Dim matchCount As Long

    On Error GoTo SearchFailed

    matchCount = _
        ApplyRecordSearch( _
            text, _
            RecordSearchCurrentLRUFilter(), _
            RecordSearchCurrentTestFilter())

    If matchCount < 0 Then
        Exit Sub
    End If

    RefreshRecordSearchRibbon

    Exit Sub


SearchFailed:

    MsgBox _
        "The record search could not be applied." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "Record Search"

End Sub


Public Sub Ribbon_RecordSearchGetText( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = _
        RecordSearchCurrentQuery()

End Sub


Public Sub Ribbon_ClearRecordSearch( _
    ByVal control As Office.IRibbonControl _
)

    On Error GoTo ClearFailed

    CancelPendingPresetFilterSearch

    ClearRecordSearch

    RefreshRecordSearchRibbon

    Exit Sub


ClearFailed:

    MsgBox _
        "The record search could not be cleared." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "Record Search"

End Sub


Public Sub Ribbon_ClearRecordSearchGetEnabled( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = _
        RecordSearchIsActive()

End Sub


'============================================================
' PRESET FILTER CALLBACKS
'============================================================

Public Sub Ribbon_LRUFilterChanged( _
    ByVal control As Office.IRibbonControl, _
    ByVal pressed As Boolean _
)

    Dim currentFilter As String
    Dim selectedFilter As String

    currentFilter = _
        RecordSearchCurrentLRUFilter()

    ' Ribbon pressed state lags during onAction.
    ' Use logical filter state to determine whether click selects or clears.
    If StrComp( _
            currentFilter, _
            control.Tag, _
            vbTextCompare) = 0 Then

        selectedFilter = _
            vbNullString

    Else

        selectedFilter = _
            control.Tag

    End If

    SetRecordSearchLRUFilter _
        selectedFilter

    ' Defer filtering until this callback returns so Excel can
    ' repaint the native toggle states first.
    InvalidatePresetFilterControls

    SchedulePresetFilterSearch

End Sub


Public Sub Ribbon_LRUFilterGetPressed( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = _
        (StrComp( _
            RecordSearchCurrentLRUFilter(), _
            control.Tag, _
            vbTextCompare) = 0)

End Sub


