Option Explicit


'============================================================
' MODULE STATE
'============================================================

Private mRibbon As Office.IRibbonUI

Private mPresetFilterSearchScheduled As Boolean
Private mPresetFilterSearchTime As Date


'============================================================
' RIBBON LIFECYCLE
'============================================================

Public Sub Ribbon_OnLoad(ByVal ribbon As Office.IRibbonUI)

    Set mRibbon = ribbon

End Sub


'============================================================
' SEARCH CALLBACKS
'============================================================

Public Sub Ribbon_RecordSearchChanged( _
    ByVal control As Office.IRibbonControl, _
    ByVal text As String _
)

    Dim matchCount As Long

    On Error GoTo SearchFailed

    matchCount = ApplyRecordSearch( _
        text, _
        RecordSearchCurrentLRUFilter(), _
        RecordSearchCurrentTestFilter())

    If matchCount < 0 Then Exit Sub

    InvalidateClearRecordSearchControl

    Exit Sub


SearchFailed:

    MsgBox _
        "The record search could not be applied." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Record Search"

End Sub


Public Sub Ribbon_RecordSearchGetText( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    Dim currentQuery As String

    currentQuery = RecordSearchCurrentQuery()

    ' Return an explicit zero-length string so the editBox receives a displayable empty value.
    If Len(currentQuery) = 0 Then

        returnedVal = ""

    Else

        returnedVal = currentQuery

    End If

End Sub


Public Sub Ribbon_ClearRecordSearch(ByVal control As Office.IRibbonControl)

    On Error GoTo ClearFailed

    CancelPendingPresetFilterSearch

    ClearRecordSearch

    InvalidateRecordSearchTextControl
    InvalidatePresetFilterControls

    Exit Sub


ClearFailed:

    MsgBox _
        "The record search could not be cleared." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Record Search"

End Sub


Public Sub Ribbon_ClearRecordSearchGetEnabled( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = RecordSearchIsActive()

End Sub


'============================================================
' PRESET FILTER CALLBACKS
'============================================================

Public Sub Ribbon_LRUFilterChanged( _
    ByVal control As Office.IRibbonControl, _
    ByVal pressed As Boolean _
)

    Dim currentFilter As String
    Dim selectedFilter As String

    currentFilter = RecordSearchCurrentLRUFilter()

    ' Ribbon pressed state lags during onAction.
    ' Use logical filter state to determine whether click selects or clears.
    If StrComp(currentFilter, control.Tag, vbTextCompare) = 0 Then

        selectedFilter = vbNullString

    Else

        selectedFilter = control.Tag

    End If

    SetRecordSearchLRUFilter selectedFilter

    ' Defer filtering until this callback returns so Excel can
    ' repaint the native toggle states first.
    InvalidatePresetFilterControls

    SchedulePresetFilterSearch

End Sub


Public Sub Ribbon_LRUFilterGetPressed( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = _
        (StrComp(RecordSearchCurrentLRUFilter(), control.Tag, vbTextCompare) = 0)

End Sub


