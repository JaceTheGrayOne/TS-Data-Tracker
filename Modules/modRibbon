'============================================================
' NAVIGATION / DEBUG CALLBACKS
'============================================================

Public Sub Ribbon_GoToTSData( _
    ByVal control As Office.IRibbonControl _
)

    ThisWorkbook.Worksheets( _
        "TS Data" _
    ).Activate

End Sub


Public Sub Ribbon_ResetWorkbookState( _
    ByVal control As Office.IRibbonControl _
)

    On Error GoTo ResetFailed

    ' Prevent queued filtering from reapplying stale state after reset.
    CancelPendingPresetFilterSearch

    If Not ResetRecordSearchStateToDefault() Then
        Exit Sub
    End If

    If Not mRibbon Is Nothing Then
        mRibbon.Invalidate
    End If

    ' Leave the custom tab so its live editBox is rebuilt on return.
    Application.SendKeys _
        "%h", _
        False

    Exit Sub


ResetFailed:

    ' Restore Excel globals even if recovery fails.
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.Interactive = True

    Application.StatusBar = False

    MsgBox _
        "The workbook state could not be completely reset." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "Reset State"

End Sub


'============================================================
' DEFERRED FILTER EXECUTION
'============================================================

Public Sub ApplyPendingPresetFilterSearch()

    Dim matchCount As Long

    On Error GoTo SearchFailed

    mPresetFilterSearchScheduled = _
        False

    matchCount = _
        ApplyRecordSearch( _
            RecordSearchCurrentQuery(), _
            RecordSearchCurrentLRUFilter(), _
            RecordSearchCurrentTestFilter())

    If matchCount < 0 Then
        Exit Sub
    End If

    RefreshRecordSearchRibbon

    Exit Sub


SearchFailed:

    mPresetFilterSearchScheduled = _
        False

    MsgBox _
        "The preset filter could not be applied." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "Record Search"

End Sub


'============================================================
' RIBBON REFRESH
'============================================================

Public Sub RefreshRecordSearchRibbon()

    If mRibbon Is Nothing Then
        Exit Sub
    End If

    ' Do not call from preset toggle onAction.
    ' Those callbacks must return before Excel can repaint their pressed state.
    mRibbon.Invalidate

    DoEvents

End Sub


Private Sub InvalidatePresetFilterControls()

    If mRibbon Is Nothing Then
        Exit Sub
    End If

    mRibbon.InvalidateControl _
        "tglLRUBMPG"

    mRibbon.InvalidateControl _
        "tglLRURMPG"

    mRibbon.InvalidateControl _
        "tglLRUSIM"

    mRibbon.InvalidateControl _
        "tglLRUOCP"

    mRibbon.InvalidateControl _
        "tglLRUOPU"

    mRibbon.InvalidateControl _
        "tglTestFunctionalRed"

    mRibbon.InvalidateControl _
        "tglTestFunctionalBlack"

    mRibbon.InvalidateControl _
        "tglTestThermal"

    mRibbon.InvalidateControl _
        "tglTestATP"

    mRibbon.InvalidateControl _
        "btnClearRecordSearch"

End Sub


'============================================================
' INTERNAL HELPERS
'============================================================

Private Sub SchedulePresetFilterSearch()

    Dim callbackName As String

    On Error GoTo ScheduleFailed

    ' Rapid preset changes collapse into one pending search using
    ' the final logical filter state.
    ' This avoids a bug that occurs when trying to rebuild
    ' The current view too rapidly.
    If mPresetFilterSearchScheduled Then
        Exit Sub
    End If

    callbackName = _
        PresetFilterSearchCallbackName()

    mPresetFilterSearchTime = _
        Now

    mPresetFilterSearchScheduled = _
        True

    Application.OnTime _
        EarliestTime:=mPresetFilterSearchTime, _
        Procedure:=callbackName

    Exit Sub


ScheduleFailed:

    mPresetFilterSearchScheduled = _
        False

    MsgBox _
        "The preset filter could not be scheduled." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.Description, _
        vbCritical, _
        "Record Search"

End Sub


Private Sub CancelPendingPresetFilterSearch()

    Dim callbackName As String

    If Not mPresetFilterSearchScheduled Then
        Exit Sub
    End If

    callbackName = _
        PresetFilterSearchCallbackName()

    On Error Resume Next

    Application.OnTime _
        EarliestTime:=mPresetFilterSearchTime, _
        Procedure:=callbackName, _
        Schedule:=False

    On Error GoTo 0

    mPresetFilterSearchScheduled = _
        False

End Sub


Private Function PresetFilterSearchCallbackName() As String

    PresetFilterSearchCallbackName = _
        "'" & _
        Replace( _
            ThisWorkbook.Name, _
            "'", _
            "''") & _
        "'!ApplyPendingPresetFilterSearch"

End Function

