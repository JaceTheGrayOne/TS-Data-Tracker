Public Sub Ribbon_TestFilterGetPressed( _
    ByVal control As Office.IRibbonControl, _
    ByRef returnedVal _
)

    returnedVal = _
        (StrComp(RecordSearchCurrentTestFilter(), control.Tag, vbTextCompare) = 0)

End Sub


'============================================================
' RELATED RECORD CALLBACKS
'============================================================

Public Sub Ribbon_FindSimilarIncidents(ByVal control As Office.IRibbonControl)

    ShowSimilarIncidentsForSelection

End Sub


'============================================================
' NAVIGATION / DEBUG CALLBACKS
'============================================================

Public Sub Ribbon_GoToTSData(ByVal control As Office.IRibbonControl)

    ThisWorkbook.Worksheets("TS Data").Activate

End Sub


Public Sub Ribbon_ResetWorkbookState(ByVal control As Office.IRibbonControl)

    On Error GoTo ResetFailed

    ' Prevent queued filtering from reapplying stale state after reset.
    CancelPendingPresetFilterSearch

    If Not ResetRecordSearchStateToDefault() Then Exit Sub

    If Not mRibbon Is Nothing Then
        mRibbon.Invalidate
    End If

    ' Leave the custom tab so its live editBox is rebuilt on return.
    Application.SendKeys "%h", False

    Exit Sub


ResetFailed:

    ' Restore Excel globals even if recovery fails.
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.Interactive = True

    Application.StatusBar = False

    MsgBox _
        "The workbook state could not be completely reset." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Reset State"

End Sub


'============================================================
' DEFERRED FILTER EXECUTION
'============================================================

Public Sub ApplyPendingPresetFilterSearch()

    Dim matchCount As Long

    On Error GoTo SearchFailed

    mPresetFilterSearchScheduled = False

    matchCount = ApplyRecordSearch( _
        RecordSearchCurrentQuery(), _
        RecordSearchCurrentLRUFilter(), _
        RecordSearchCurrentTestFilter())

    If matchCount < 0 Then Exit Sub

    RefreshRecordSearchRibbon

    Exit Sub


SearchFailed:

    mPresetFilterSearchScheduled = False

    MsgBox _
        "The preset filter could not be applied." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Record Search"

End Sub


'============================================================
' RIBBON REFRESH
'============================================================

Public Sub RefreshRecordSearchRibbon()

    If mRibbon Is Nothing Then Exit Sub

    ' Do not call from preset toggle onAction.
    ' Those callbacks must return before Excel can repaint their pressed state.
    mRibbon.Invalidate

    DoEvents

End Sub


Private Sub InvalidateRecordSearchTextControl()

    If mRibbon Is Nothing Then Exit Sub

    mRibbon.InvalidateControl "txtRecordSearch"

End Sub


Private Sub InvalidateClearRecordSearchControl()

    If mRibbon Is Nothing Then Exit Sub

    mRibbon.InvalidateControl "btnClearRecordSearch"

End Sub


Private Sub InvalidatePresetFilterControls()

    If mRibbon Is Nothing Then Exit Sub

    mRibbon.InvalidateControl "tglLRUBMPG"
    mRibbon.InvalidateControl "tglLRURMPG"
    mRibbon.InvalidateControl "tglLRUSIM"
    mRibbon.InvalidateControl "tglLRUOCP"
    mRibbon.InvalidateControl "tglLRUOPU"

    mRibbon.InvalidateControl "tglTestFunctionalRed"
    mRibbon.InvalidateControl "tglTestFunctionalBlack"
    mRibbon.InvalidateControl "tglTestThermal"
    mRibbon.InvalidateControl "tglTestATP"

    mRibbon.InvalidateControl "btnClearRecordSearch"

End Sub


'============================================================
' INTERNAL HELPERS
'============================================================

Private Sub SchedulePresetFilterSearch()

    Dim callbackName As String

    On Error GoTo ScheduleFailed

    ' Rapid preset changes collapse into one pending search using
    ' the final logical filter state.
    ' This avoids a bug that occurs when trying to rebuild
    ' The current view too rapidly.
    If mPresetFilterSearchScheduled Then Exit Sub

    callbackName = PresetFilterSearchCallbackName()

    mPresetFilterSearchTime = Now
    mPresetFilterSearchScheduled = True

    Application.OnTime _
        EarliestTime:=mPresetFilterSearchTime, _
        Procedure:=callbackName

    Exit Sub


ScheduleFailed:

    mPresetFilterSearchScheduled = False

    MsgBox _
        "The preset filter could not be scheduled." & _
        vbCrLf & vbCrLf & _
        "Error " & CStr(Err.Number) & _
        vbCrLf & _
        Err.description, _
        vbCritical, _
        "Record Search"

End Sub


Private Sub CancelPendingPresetFilterSearch()

    Dim callbackName As String

    If Not mPresetFilterSearchScheduled Then Exit Sub

    callbackName = PresetFilterSearchCallbackName()

    On Error Resume Next

    Application.OnTime _
        EarliestTime:=mPresetFilterSearchTime, _
        Procedure:=callbackName, _
        Schedule:=False

    On Error GoTo 0

    mPresetFilterSearchScheduled = False

End Sub


Private Function PresetFilterSearchCallbackName() As String

    PresetFilterSearchCallbackName = _
        "'" & Replace(ThisWorkbook.Name, "'", "''") & _
        "'!ApplyPendingPresetFilterSearch"

End Function

